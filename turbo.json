{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["WEB_BUILD_CACHE_TOKEN"],
      "passThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "check": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@commission-index/web#fact-source:export": {
      "env": ["WEB_BUILD_CACHE_TOKEN"],
      "passThroughEnv": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "FACT_SOURCE_USE_EXISTING_SNAPSHOT"
      ],
      "outputs": [],
      "cache": false
    },
    "@commission-index/web#build": {
      "dependsOn": ["^build", "fact-source:export"],
      "env": ["WEB_BUILD_CACHE_TOKEN"],
      "passThroughEnv": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "FACT_SOURCE_USE_EXISTING_SNAPSHOT"
      ],
      "outputs": ["dist/**", ".astro/**"],
      "inputs": ["$TURBO_DEFAULT$", "generated/**"],
      "cache": false
    },
    "@commission-index/web#check": {
      "dependsOn": ["^typecheck", "fact-source:export"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
