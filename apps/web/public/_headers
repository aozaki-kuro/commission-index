/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: on
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex

/build-info.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: https://admin.crystallize.cc

/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/search/home-search-entries.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/search/home-character-batches/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/search/home-timeline-batches/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/rss.xml
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/search/home-character-manifest/*
  Cache-Control: no-cache

/search/home-timeline-manifest/*
  Cache-Control: no-cache

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
