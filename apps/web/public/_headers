/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: on
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex

/build-info.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: https://admin.crystallize.cc

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/search/home-search-entries.*.json
  Cache-Control: public, max-age=31536000, immutable

/search/home-character-batches/*
  Cache-Control: public, max-age=31536000, immutable

/search/home-timeline-batches/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/rss.xml
  Cache-Control: no-cache

/search/home-character-manifest/*
  Cache-Control: no-cache

/search/home-timeline-manifest/*
  Cache-Control: no-cache

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon-transparent.svg
  Cache-Control: public, max-age=86400

/favicon/*
  Cache-Control: public, max-age=86400

/nsfw-cover-s.*
  Cache-Control: public, max-age=86400
