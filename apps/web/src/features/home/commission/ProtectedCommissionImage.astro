---
import type { ImageMetadata } from 'astro'
import {
  COMMISSION_IMAGE_SIZES,
  COMMISSION_IMAGE_WIDTH,
  COMMISSION_INLINE_IMAGE_WIDTHS,
} from '@features/home/commission/commissionImageConstants'
import { Image } from 'astro:assets'

interface ProtectedCommissionImageProps {
  altText: string
  sourceImage: ImageMetadata
  priority?: boolean
}

const { altText, sourceImage, priority = false } = Astro.props as ProtectedCommissionImageProps
// The skeleton pulses only until imageFadeIn marks the wrapper `data-loaded`; an unconditional pulse kept ~90
// infinite animations running behind loaded images. Class strings stay on one line: this markup repeats per entry.

---

<div
  data-commission-image="true"
  data-commission-alt={altText}
  data-loaded={priority ? '' : undefined}
  class="relative before:pointer-events-none before:absolute before:inset-0 not-data-loaded:before:animate-pulse before:bg-gray-100 before:content-[''] dark:before:bg-gray-800"
>
  <Image
    src={sourceImage}
    alt={altText}
    widths={COMMISSION_INLINE_IMAGE_WIDTHS}
    width={COMMISSION_IMAGE_WIDTH}
    format="webp"
    sizes={COMMISSION_IMAGE_SIZES}
    class="pointer-events-none relative z-10 block w-full select-none"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    style="height:auto"
  />
</div>
