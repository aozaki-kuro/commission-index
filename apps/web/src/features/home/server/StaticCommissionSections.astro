---
import type { TimelineYearGroup } from '@commission-index/domain'
import type { CharacterCommissions } from '@data/types'
import Listing from '@features/home/commission/Listing.astro'
import TimelineView from '@features/home/commission/TimelineView.astro'
import { getHomeLocaleMessages, normalizeHomeLocale } from '@features/home/i18n/homeLocale'
import {
  buildHomeCharacterBatchManifest,
} from '@features/home/server/homeCharacterBatchArtifacts'
import {
  buildHomeCharacterBatchPlan,
} from '@features/home/server/homeCharacterBatches'
import {
  buildHomeTimelineBatchManifest,
} from '@features/home/server/homeTimelineBatchArtifacts'
import {
  buildHomeTimelineBatchPlan,
} from '@features/home/server/homeTimelineBatches'
import { buildHomeSearchEntriesArtifact } from '@lib/pipeline/homeSearchEntries'

type CharacterDisplay = {
  DisplayName: string
}

interface StaticCommissionSectionsProps {
  locale?: string
  activeChars: CharacterDisplay[]
  archivedChars: CharacterDisplay[]
  commissionMap: Map<string, CharacterCommissions>
  timelineGroups: TimelineYearGroup[]
  characterAliasesMap: Map<string, string[]>
  creatorAliasesMap: Map<string, string[]>
  keywordAliasesMap: Map<string, string[]>
}

const {
  locale,
  activeChars,
  archivedChars,
  commissionMap,
  timelineGroups,
  characterAliasesMap,
  creatorAliasesMap,
  keywordAliasesMap,
}
  = Astro.props as StaticCommissionSectionsProps
const messages = getHomeLocaleMessages(normalizeHomeLocale(locale))
const resolvedLocale = normalizeHomeLocale(locale)
const batchPlan = buildHomeCharacterBatchPlan({
  activeChars,
  archivedChars,
  commissionMap,
})
const batchManifest = await buildHomeCharacterBatchManifest({
  characterAliasesMap,
  commissionMap,
  creatorAliasesMap,
  keywordAliasesMap,
  locale: resolvedLocale,
  plan: batchPlan,
  searchEntriesVersion: buildHomeSearchEntriesArtifact().version,
})
const timelineBatchPlan = buildHomeTimelineBatchPlan({
  groups: timelineGroups,
})
const timelineBatchManifest = await buildHomeTimelineBatchManifest({
  characterAliasesMap,
  creatorAliasesMap,
  keywordAliasesMap,
  locale: resolvedLocale,
  plan: timelineBatchPlan,
  searchEntriesVersion: buildHomeSearchEntriesArtifact().version,
})
const activeCommissionCount = activeChars.reduce(
  (count, chara) => count + (commissionMap.get(chara.DisplayName)?.Commissions.length ?? 0),
  0,
)
const timelineCommissionCount = timelineGroups.reduce((count, group) => count + group.entries.length, 0)
const archivedCharacterCount = archivedChars.length
const archivedCommissionCount = archivedChars.reduce(
  (count, chara) => count + (commissionMap.get(chara.DisplayName)?.Commissions.length ?? 0),
  0,
)
---

<div id="--------Commissions--------" data-search-index-version={buildHomeSearchEntriesArtifact().version}>
  <div
    data-commission-view-panel="character"
    data-commission-view-active="true"
    data-total-entries={activeCommissionCount}
    data-archived-visibility="hidden"
  >
    {
      activeChars.map((chara, charIndex) => (
        <Listing
          locale={locale}
          Character={chara.DisplayName}
          status="active"
          commissionMap={commissionMap}
          characterAliasesMap={characterAliasesMap}
          creatorAliasesMap={creatorAliasesMap}
          keywordAliasesMap={keywordAliasesMap}
          priorityFirstImage={charIndex === 0}
        />
      ))
    }
    {
      archivedChars.length > 0
? (
        <>
          <div data-archived-sections-placeholder="true" class="pb-8">
            <div class="mx-auto max-w-lg pt-12 text-center">
              <p class="
                text-[11px] tracking-[0.08em] text-stone-500
                dark:text-stone-400
              "
              >
                {messages.controls.formatCollapsedArchivedSummary(
                  archivedCharacterCount,
                  archivedCommissionCount,
                )}
              </p>

              <p class="
                mt-3 text-base/7 font-semibold text-stone-700
                dark:text-stone-200
              "
              >
                {messages.controls.archivedCharactersCollapsedTitle}
              </p>
              <p class="
                mx-auto mt-1.5 max-w-md text-sm/6 text-stone-500
                dark:text-stone-400
              "
              >
                {messages.controls.archivedCharactersCollapsedHint}
              </p>

              <button
                type="button"
                data-load-archived-characters="true"
                class="
                  group mt-5 inline-flex items-center gap-1.5
                  border-0 bg-transparent p-0 text-sm text-stone-600
                  transition-colors
                  hover:text-stone-900
                  dark:text-stone-300
                  dark:hover:text-white
                "
              >
                <svg
                  viewBox="0 0 24 24"
                  class="
                    size-4 text-stone-400 transition-transform duration-200
                    group-hover:translate-y-0.5 group-hover:text-current
                    dark:text-stone-500
                  "
                  fill="none"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="m6 9 6 6 6-6"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{messages.controls.loadArchivedCharacters}</span>
              </button>
            </div>
          </div>
          <div data-archived-divider="true" class="hidden pb-12"></div>
          <div data-archived-sections-container="true" class="hidden">
            {
              archivedChars.map(chara => (
                <Listing
                  locale={locale}
                  Character={chara.DisplayName}
                  status="archived"
                  commissionMap={commissionMap}
                  characterAliasesMap={characterAliasesMap}
                  creatorAliasesMap={creatorAliasesMap}
                  keywordAliasesMap={keywordAliasesMap}
                />
              ))
            }
          </div>
        </>
      )
: null
    }
  </div>

  <div
    data-commission-view-panel="timeline"
    data-commission-view-active="false"
    data-total-entries={timelineCommissionCount}
    class="hidden"
  >
    <TimelineView
      groups={timelineGroups}
      characterAliasesMap={characterAliasesMap}
      creatorAliasesMap={creatorAliasesMap}
      keywordAliasesMap={keywordAliasesMap}
    />
  </div>
  <script
    is:inline
    type="application/json"
    data-home-character-batch-manifest="true"
    set:html={JSON.stringify(batchManifest)}
  />
  <script
    is:inline
    type="application/json"
    data-home-timeline-batch-manifest="true"
    set:html={JSON.stringify(timelineBatchManifest)}
  />
</div>

<script is:inline>
const initialMode
  = new URLSearchParams(window.location.search).get('view') === 'timeline'
    ? 'timeline'
    : 'character'

let initialHashId = ''
try {
  initialHashId = decodeURIComponent(window.location.hash.slice(1))
}
catch {
  initialHashId = ''
}

if (initialMode === 'timeline') {
  const setCommissionPanelState = (panelName, active) => {
    const panel = document.querySelector(`[data-commission-view-panel="${panelName}"]`)
    if (!(panel instanceof HTMLElement))
      return

    panel.dataset.commissionViewActive = active ? 'true' : 'false'
    panel.classList.toggle('hidden', !active)
  }

  const syncPanelGroupVisibility = ({ panelSelector, dataKey }) => {
    document.querySelectorAll(panelSelector).forEach((panel) => {
      if (!(panel instanceof HTMLElement))
        return
      panel.classList.toggle('hidden', panel.dataset[dataKey] !== initialMode)
    })
  }

  const syncToggleGroupState = ({
    toggleSelector,
    indicatorSelector,
    activeTextClasses,
    inactiveTextClasses,
    activeIndicatorClasses,
    inactiveIndicatorClasses,
  }) => {
    document.querySelectorAll(toggleSelector).forEach((button) => {
      if (!(button instanceof HTMLButtonElement))
        return

      const active = button.dataset.viewMode === initialMode
      button.setAttribute('aria-pressed', String(active))

      activeTextClasses.forEach((className) => {
        button.classList.toggle(className, active)
      })
      inactiveTextClasses.forEach((className) => {
        button.classList.toggle(className, !active)
      })

      const indicator = button.querySelector(indicatorSelector)
      if (!(indicator instanceof HTMLElement))
        return

      activeIndicatorClasses.forEach((className) => {
        indicator.classList.toggle(className, active)
      })
      inactiveIndicatorClasses.forEach((className) => {
        indicator.classList.toggle(className, !active)
      })
    })
  }

  setCommissionPanelState('character', false)
  setCommissionPanelState('timeline', true)

  syncPanelGroupVisibility({
    panelSelector: '[data-sidebar-nav-panel]',
    dataKey: 'sidebarNavPanel',
  })
  syncPanelGroupVisibility({
    panelSelector: '[data-mobile-hamburger-nav-panel]',
    dataKey: 'mobileHamburgerNavPanel',
  })

  syncToggleGroupState({
    toggleSelector: '[data-sidebar-view-mode-toggle="true"]',
    indicatorSelector: '[data-sidebar-view-mode-indicator]',
    activeTextClasses: ['text-gray-900', 'dark:text-white'],
    inactiveTextClasses: ['text-gray-700', 'dark:text-gray-200'],
    activeIndicatorClasses: ['scale-100', 'opacity-100'],
    inactiveIndicatorClasses: ['scale-95', 'opacity-0'],
  })
  syncToggleGroupState({
    toggleSelector: '[data-mobile-view-mode-toggle="true"]',
    indicatorSelector: '[data-mobile-view-mode-indicator]',
    activeTextClasses: ['text-gray-700', 'dark:text-gray-300'],
    inactiveTextClasses: ['text-gray-500', 'dark:text-gray-400'],
    activeIndicatorClasses: ['w-full', 'opacity-100'],
    inactiveIndicatorClasses: ['w-0', 'opacity-0'],
  })
  syncToggleGroupState({
    toggleSelector: '[data-mobile-hamburger-view-mode-toggle="true"]',
    indicatorSelector: '[data-mobile-hamburger-view-mode-indicator="true"]',
    activeTextClasses: ['text-gray-900', 'dark:text-white'],
    inactiveTextClasses: ['text-gray-700', 'dark:text-gray-200'],
    activeIndicatorClasses: ['scale-100', 'opacity-100'],
    inactiveIndicatorClasses: ['scale-95', 'opacity-0'],
  })

  // Native fragment scroll targets the first matching id, which is the hidden character-panel copy of a
  // shared entry id, so jump to the timeline copy before first paint. homeHashTarget owns it after mount.
  if (initialHashId) {
    const escapedHashId = initialHashId.replace(/\\/g, '\\\\').replace(/"/g, '\\"')
    const timelineTarget = document
      .querySelector('[data-commission-view-panel="timeline"]')
      ?.querySelector(`[id="${escapedHashId}"]`)
    if (timelineTarget instanceof HTMLElement) {
      timelineTarget.scrollIntoView()
    }
  }
}

// Show archived before first paint when the hash targets an entry inside it, so native fragment
// scrolling lands on it instead of on a display: none element. Timeline view resolves shared ids to
// its own copy, so archived stays collapsed there.
if (initialMode === 'character' && initialHashId) {
  const archivedTarget = document.getElementById(initialHashId)
  const archivedContainer = archivedTarget?.closest('[data-archived-sections-container="true"]')
  const characterPanel = document.querySelector('[data-commission-view-panel="character"]')
  if (archivedContainer instanceof HTMLElement && characterPanel instanceof HTMLElement) {
    archivedContainer.classList.remove('hidden')
    characterPanel.querySelector('[data-archived-divider="true"]')?.classList.remove('hidden')
    characterPanel.querySelector('[data-archived-sections-placeholder="true"]')?.classList.add('hidden')
    characterPanel.dataset.archivedVisibility = 'visible'
  }
}
</script>
