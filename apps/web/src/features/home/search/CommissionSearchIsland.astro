---
import type { SearchSuggestionAliasGroup } from '@features/home/search/commissionSearchIndex'
import type { KeywordBrowseGroup } from '@lib/home/keywordBrowseGroups'
import { resolveHomeSearchControls } from '@features/home/i18n/homeSearchControls'
import { STYLES } from '@features/home/nav/hamburger/constants'
import { KEYWORD_CHIP_SURFACE_CLASS } from '@features/home/search/commissionSearchConstants'
import { Icon } from 'astro-icon/components'

interface Props {
  locale?: string
  featuredKeywords?: string[]
  suggestionAliasGroups?: SearchSuggestionAliasGroup[]
  keywordBrowseSections?: { label: string, groups: KeywordBrowseGroup[] }[]
}

const {
  locale,
  featuredKeywords = [],
  suggestionAliasGroups = [],
  keywordBrowseSections = [],
} = Astro.props

const controls = resolveHomeSearchControls(locale)
// Terms carry data-link-style for the site's link hover (opacity) without its underline; a color hover or transition
// utility here would beat that base rule.
const browseTermClass = `
  rounded-sm text-left no-underline
  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-500
  dark:focus-visible:outline-gray-400
`
// One tone below the character name; set on the button because the li base rule sets color.
const browseKeywordClass = `${browseTermClass} text-gray-600 dark:text-gray-400`
---

<section
  id="commission-search"
  class="
    mt-4 mb-8
    md:mt-4 md:mb-10
    lg:mt-6 lg:mb-12
  "
  data-locale={locale}
  data-featured-keywords={JSON.stringify(featuredKeywords)}
  data-suggestion-alias-groups={JSON.stringify(suggestionAliasGroups)}
>
  <div class="flex h-12 items-center justify-end">
    <div class="
      relative h-11 w-full overflow-visible border-b border-gray-300/80
      bg-transparent text-gray-700
      dark:border-gray-700 dark:text-gray-300
    "
    >
      {/* Search icon */}
      <Icon
        name="tabler:search"
        aria-hidden="true"
        class="
          absolute top-1/2 left-2.5 size-3.5 shrink-0 -translate-y-1/2
          opacity-70
        "
      />

      <div class="
        absolute inset-y-0 right-2 left-8 flex items-center gap-2
      "
      >
        {/* Combobox wrapper */}
        <div
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-owns="search-suggestion-list"
          class="relative size-full overflow-visible bg-transparent"
        >
          <label for="commission-search-input" class="sr-only">
            {controls.searchCommissions}
          </label>

          <input
            id="commission-search-input"
            type="text"
            value=""
            placeholder={controls.searchPlaceholder}
            autocomplete="off"
            aria-label={controls.searchCommissions}
            class="
              peer m-0 flex h-10 w-[calc(100%/0.875)] origin-left
              scale-[0.875] appearance-none rounded-md bg-transparent p-0
              pr-24 text-base/5 outline-none
              placeholder:text-gray-400
            "
          />

          {/* Suggestion dropdown (starts collapsed, animated open/close by controller) */}
          <ul
            id="search-suggestion-list"
            role="listbox"
            class="
              absolute inset-x-0 top-[calc(100%+0.5rem)] z-20 max-h-[min(70dvh,28rem)]
              menu-glass overflow-y-auto overscroll-contain py-1 text-sm
              pointer-events-none origin-top scale-y-[0.96] opacity-0
              motion-safe:transition-[opacity,scale] motion-safe:duration-120
              motion-safe:ease-exit
              motion-reduce:transition-none
            "
          ></ul>
        </div>

        {/* Help trigger button */}
        <button
          id="search-help-trigger"
          type="button"
          class="
            absolute right-0 inline-flex size-7 items-center justify-center
            rounded-full text-gray-500 transition-[right,opacity]
            duration-200
            hover:opacity-70
            focus-visible:outline-2 focus-visible:outline-offset-2
            focus-visible:outline-gray-500
            dark:text-gray-400
            dark:focus-visible:outline-gray-400
          "
          aria-label={controls.searchHelp}
          popovertarget="search-help-popover"
        >
          <Icon name="tabler:help-circle" class="size-5" aria-hidden="true" />
        </button>

        {/* Help popover */}
        <div
          id="search-help-popover"
          popover
          class="
            menu-glass m-auto w-[min(calc(100vw-1rem),26rem)] overflow-auto p-0 text-gray-700
            md:text-base
            dark:text-gray-300
          "
        >
          <div data-help-content class="space-y-3 p-4">
            <h2 class="
              text-base font-bold text-gray-900
              md:text-lg
              dark:text-gray-100
            "
            >
              {controls.searchHelpTitle}
            </h2>
            <p class="
              text-xs
              md:text-sm
            "
            >
              {controls.searchHelpIntro}
            </p>

            <div class="
              max-h-[min(50dvh,22rem)] overflow-auto rounded-lg border
              border-gray-200/90
              dark:border-gray-700/90
            "
            >
              <table class="
                w-full min-w-[18rem] border-separate border-spacing-0 text-left
                text-xs/relaxed
                md:text-sm
              "
              >
                <thead class="
                  sticky top-0 bg-gray-100/90 text-gray-600
                  dark:bg-gray-800/90 dark:text-gray-300
                "
                >
                  <tr>
                    <th class="px-3 py-2 font-semibold">{controls.searchHelpSyntaxHeader}</th>
                    <th class="px-3 py-2 font-semibold">{controls.searchHelpMeaningHeader}</th>
                  </tr>
                </thead>

                <tbody class="
                  divide-y divide-gray-200/80
                  dark:divide-gray-700/80
                "
                >
                  {controls.searchHelpRows.map(row => (
                    <tr class="align-top">
                      <td class="w-20 px-3 py-2.5">
                        <code class="
                          rounded-sm bg-gray-100 px-1.5 py-0.5 font-mono text-2xs
                          text-gray-700
                          md:text-xs
                          dark:bg-gray-800 dark:text-gray-200
                        "
                        >
                          {row.syntax}
                        </code>
                      </td>
                      <td class="
                        px-3 py-2.5 text-2xs
                        sm:text-xs
                        md:text-sm
                      "
                      >
                        <p>{row.description}</p>
                        <p class="
                          mt-0.5 wrap-break-word text-gray-500
                          dark:text-gray-400
                        "
                        >
                          {controls.searchHelpExampleLabel}:
                          {' '}
                          <code class="
                            rounded-sm bg-gray-100 px-1.5 py-0.5 font-mono
                            text-2xs text-gray-600
                            md:text-xs
                            dark:bg-gray-800 dark:text-gray-300
                          "
                          >
                            {row.example}
                          </code>
                        </p>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="
              text-2xs wrap-break-word text-gray-500
              sm:text-xs
              md:text-sm
              dark:text-gray-400
            "
            >
              {controls.searchHelpCombinedExampleLabel}:
              {' '}
              <code class="
                rounded-sm bg-gray-100 px-1.5 py-0.5 font-mono text-2xs
                text-gray-600
                md:text-xs
                dark:bg-gray-800 dark:text-gray-300
              "
              >
                blue hair | silver !sketch
              </code>
            </p>
            <p class="
              text-2xs wrap-break-word text-gray-500
              sm:text-xs
              md:text-sm
              dark:text-gray-400
            "
            >
              {controls.searchHelpAliasHint}
            </p>
            <div class="flex justify-end">
              <button
                type="button"
                class="
                  rounded-md border border-gray-300/80 bg-white/85 px-3 py-1.5
                  text-xs font-semibold text-gray-700 transition-colors
                  hover:bg-gray-900/6
                  focus-visible:outline-2 focus-visible:outline-offset-2
                  focus-visible:outline-gray-500
                  dark:border-gray-600 dark:bg-gray-900/80 dark:text-gray-200
                  dark:hover:bg-white/10
                  dark:focus-visible:outline-gray-400
                "
                popovertarget="search-help-popover"
                popovertargetaction="hide"
              >
                {controls.searchHelpClose}
              </button>
            </div>
          </div>
        </div>

        {/* Copy URL button (hidden until query exists) */}
        <button
          id="search-copy-url"
          type="button"
          class="
            absolute right-8 inline-flex size-7 items-center justify-center
            rounded-full text-gray-500 transition-opacity duration-150
            pointer-events-none opacity-0
            hover:opacity-70
            focus-visible:outline-2 focus-visible:outline-offset-2
            focus-visible:outline-gray-500
            dark:text-gray-400
            dark:focus-visible:outline-gray-400
          "
          aria-label={controls.copySearchUrl}
        >
          {/* Share icon (visible by default) */}
          <Icon name="tabler:share-3" data-icon="share" class="size-4.5" aria-hidden="true" />
          {/* Check icon (hidden, shown on copy success) */}
          <Icon name="tabler:check" data-icon="check" class="size-4.5 hidden" aria-hidden="true" />
        </button>

        {/* Clear button (hidden until query exists) */}
        <button
          id="search-clear"
          type="button"
          class="
            absolute right-0 inline-flex size-7 items-center justify-center
            rounded-full text-gray-500 transition-opacity
            pointer-events-none opacity-0
            hover:opacity-70
            focus-visible:outline-2 focus-visible:outline-offset-2
            focus-visible:outline-gray-500
            dark:text-gray-400
            dark:focus-visible:outline-gray-400
          "
          aria-label={controls.clearSearch}
        >
          <Icon name="tabler:x" class="size-5" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>

  {/* Popular keywords row (invisible to reserve space, fades in when populated) */}
  <div
    id="search-popular-keywords"
    class="
      mt-2 flex min-h-8 w-full items-center gap-2 overflow-hidden pr-2 text-xs
      text-gray-500 invisible opacity-0
      motion-safe:transition-[visibility,opacity] motion-safe:duration-200 motion-safe:ease-out
      dark:text-gray-400
    "
  >
    <ul
      id="search-keyword-list"
      class="
        flex min-w-0 flex-1 flex-nowrap items-center gap-1.5 overflow-x-auto
        pr-0.5
      "
    />
    <div class="flex shrink-0 gap-1.5">
      {/* Opens the full character/keyword list; the row above only shows the featured few */}
      {keywordBrowseSections.length > 0 && (
        <button
          id="search-browse-trigger"
          type="button"
          popovertarget="search-browse-popover"
          class={`${KEYWORD_CHIP_SURFACE_CLASS} inline-flex h-7 shrink-0 items-center gap-0.5 pr-2 pl-2.5`}
        >
          {controls.browseKeywordsLabel}
          <Icon name="tabler:chevron-down" class="size-3.5" aria-hidden="true" />
        </button>
      )}
    </div>
  </div>

  {/* Browse popover: outside the keyword row, whose hidden-until-populated visibility would inherit into it */}
  {keywordBrowseSections.length > 0 && (
    <div
      id="search-browse-popover"
      popover
      role="dialog"
      aria-label={controls.browseKeywordsLabel}
      class="
        m-auto max-h-[min(70dvh,34rem)] w-[min(calc(100vw-1rem),36rem)]
        menu-glass flex-col overflow-hidden p-0
        open:flex
      "
    >
      {/* The list scrolls inside, not the popover: menu-glass's backdrop-filter makes the popover the containing block
          of the close button, which would scroll away with the list if the popover itself scrolled. */}
      <div class="min-h-0 flex-1 overflow-auto overscroll-contain">
        {/* Desktop hierarchy comes from type size and tone alone, like apple.com's nav flyout: no dividers, chips or
            icons. Below 48rem the scoped CSS turns it into one field of chips instead (see there). */}
        <div
          data-browse-sections="true"
          class="
            grid gap-x-8 gap-y-10 px-6 pt-5
            pb-[max(1rem,env(safe-area-inset-bottom))]
            max-md:px-12 max-md:pt-16 max-md:pb-28
            md:grid-cols-2
          "
        >
          {/* The full-screen panel names itself at the hamburger rows' size; the dialog's aria-label already does for
              assistive tech. */}
          <p
            data-browse-title="true"
            aria-hidden="true"
            class="
              text-[28px]/tight font-semibold tracking-[0.007em] text-gray-800
              md:hidden
              dark:text-gray-100
            "
          >
            {controls.browseKeywordsTitle}
          </p>
          {keywordBrowseSections.map(section => (
            <section>
              <h2 class="
                mb-3.5 text-sm font-normal text-gray-500
                max-md:sr-only
                dark:text-gray-400
              "
              >
                {section.label}
              </h2>
              <ul class="space-y-5">
                {section.groups.map(group => (
                  <li
                    data-browse-group="true"
                    data-browse-name-only={group.coCharacters.length + group.keywords.length === 0 || undefined}
                  >
                    <button
                      type="button"
                      data-browse-term={group.character}
                      data-browse-name="true"
                      data-link-style="true"
                      class={`${browseTermClass} group text-[17px]/tight font-semibold text-gray-900 dark:text-gray-100`}
                    >
                      {group.character}
                      {/* Slides in on hover: the name searches everything of the character, like a "more" link */}
                      <Icon
                        name="tabler:chevron-right"
                        class="
                          ml-1 inline-block size-4 -translate-x-1 align-[-0.125em] opacity-0
                          transition-[opacity,translate] duration-200 ease-out
                          group-hover:translate-x-0 group-hover:opacity-100
                          group-focus-visible:translate-x-0 group-focus-visible:opacity-100
                          max-md:hidden
                        "
                        aria-hidden="true"
                      />
                    </button>
                    {(group.coCharacters.length > 0 || group.keywords.length > 0) && (
                      <ul class="
                        mt-1.5 flex flex-wrap gap-x-3 gap-y-0.5 text-sm/6
                      "
                      >
                        {/* A co-appearance ("w/ Name") searches both characters, so it finds the shared works instead of everything of the other */}
                        {group.coCharacters.map(coCharacter => (
                          <li>
                            <button
                              type="button"
                              data-browse-term={coCharacter}
                              data-browse-scope={group.character}
                              aria-label={`${group.character} ${coCharacter}`}
                              data-browse-keyword="true"
                              data-link-style="true"
                              class={browseKeywordClass}
                            >
                              <span aria-hidden="true">w/</span>
                              {' '}
                              {coCharacter}
                            </button>
                          </li>
                        ))}
                        {group.keywords.map(keyword => (
                          <li>
                            <button type="button" data-browse-term={keyword} data-browse-keyword="true" data-link-style="true" class={browseKeywordClass}>
                              {keyword}
                            </button>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
      {/* Full screen has no backdrop to tap, so the sheet carries its own X, in the hamburger toggle's spot and style:
          one place closes every full-screen panel, within thumb reach. It turns in like the hamburger toggle's icon. */}
      <div class="
        absolute right-8 bottom-8
        md:hidden
      "
      >
        <button
          type="button"
          popovertarget="search-browse-popover"
          popovertargetaction="hide"
          aria-label={controls.searchHelpClose}
          class={STYLES.floatingButton}
        >
          <Icon data-browse-close-icon="true" name="tabler:x" class="size-5" aria-hidden="true" />
        </button>
      </div>
    </div>
  )}

  {/* Live region for screen reader announcements */}
  <p id="search-live-region" aria-live="polite" class="sr-only" />
</section>

<style>
  #search-help-popover {
    --search-help-width: min(calc(100vw - 1rem), 26rem);
    max-height: calc(100dvh - 1rem);
  }

  #search-browse-popover {
    --search-browse-width: min(calc(100vw - 1rem), 36rem);
  }

  #search-help-popover,
  #search-browse-popover {
    opacity: 0;
    transform: scale(0.97);
    transform-origin: top right;
    transition:
      opacity 120ms var(--ease-exit),
      transform 120ms var(--ease-exit),
      display 120ms allow-discrete,
      overlay 120ms allow-discrete;
  }

  #search-help-popover:popover-open,
  #search-browse-popover:popover-open {
    opacity: 1;
    transform: scale(1);
    transition-duration: 180ms;
    transition-timing-function: var(--ease-enter);
  }

  @starting-style {
    #search-help-popover:popover-open,
    #search-browse-popover:popover-open {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  @supports (position-anchor: --search-help) {
    #search-help-trigger {
      anchor-name: --search-help;
    }

    #search-help-popover {
      position-anchor: --search-help;
      inset: auto;
      top: calc(anchor(bottom) + 0.5rem);
      right: clamp(0.5rem, anchor(right), calc(100vw - var(--search-help-width) - 0.5rem));
      margin: 0;
      position-try-fallbacks: flip-block, --search-help-constrained;
    }

    /* Keep the close control reachable when neither side has room for the full panel. */
    @position-try --search-help-constrained {
      bottom: 0.5rem;
      height: auto;
    }
  }

  @supports (position-anchor: --search-browse) {
    #search-browse-trigger {
      anchor-name: --search-browse;
    }

    #search-browse-popover {
      position-anchor: --search-browse;
      inset: auto;
      top: calc(anchor(bottom) + 0.5rem);
      right: clamp(0.5rem, anchor(right), calc(100vw - var(--search-browse-width) - 0.5rem));
      margin: 0;
      position-try-fallbacks: flip-block;
    }
  }

  /* Narrow screens get a full-screen panel instead of an anchored popover (Apple HIG: no popovers in compact width).
     Not a bottom sheet: a sheet promises swipe-down to dismiss, and its sliver of page is too thin to tap or read.
     It matches the hamburger menu and apple.com's mobile nav submenus, which are full screen too. */
  @media (width < 48rem) {
    #search-browse-popover {
      inset: 0;
      width: 100%;
      /* The UA popover height is fit-content, which leaves a short list hanging from the top instead of reaching the bottom. */
      height: auto;
      max-height: none;
      margin: 0;
      border-width: 0;
      border-radius: 0;
      position-try-fallbacks: none;
      /* Denser light tint over a full page of content; kept here because a breakpoint utility would also beat
         the dark tint from menu-glass. */
      background-color: rgb(255 255 255 / 0.9);
    }

    @media (prefers-color-scheme: dark) {
      #search-browse-popover {
        background-color: rgb(23 23 23 / 0.8); /* gray-900 (#171717), the page ink */
      }
    }

    /* Fade only, like the hamburger panel: a full-screen scale would read as the page zooming. */
    #search-browse-popover,
    #search-browse-popover:popover-open {
      transform: none;
    }

    @starting-style {
      #search-browse-popover:popover-open {
        transform: none;
      }
    }

    /* A popover does not lock page scroll: a drag that chains out of a list too short to scroll would move the
       listing behind it. Same lock as the hamburger menu, keyed on the open state so every close path (Esc, the X,
       a term click) releases it. */
    :global(html:has(#search-browse-popover:popover-open)) {
      overflow: hidden;
      touch-action: none;
    }

    /* The floating buttons sit under the sheet's X; hide them so only the X's turn moves while the panel fades in. */
    :global(html:has(#search-browse-popover:popover-open) [data-mobile-hamburger]),
    :global(html:has(#search-browse-popover:popover-open) [data-mobile-keyword-button-root]) {
      opacity: 0;
    }

    /* Same quarter turn, duration and ease as the hamburger toggle's icon. */
    :global([data-browse-close-icon]) {
      transition: rotate 300ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    #search-browse-popover:not(:popover-open) :global([data-browse-close-icon]) {
      rotate: -90deg;
    }

    @starting-style {
      #search-browse-popover:popover-open :global([data-browse-close-icon]) {
        rotate: -90deg;
      }
    }

    /* The hamburger already lists characters to jump to, so here the panel is one field of chips (filters), sections
       merged in sidebar order: a character with terms takes a full row led by its tinted name chip, and consecutive
       name-only characters share rows. Each row is therefore all tinted (names), one tinted chip plus outlined ones (a
       character and its terms) or all outlined (their wrap). The surface matches KEYWORD_CHIP_SURFACE_CLASS. */
    [data-browse-sections] {
      display: flex;
      flex-wrap: wrap;
      align-content: flex-start;
      gap: 1rem 0.5rem;
    }

    [data-browse-sections] > section,
    [data-browse-sections] > section > ul,
    [data-browse-group] > ul {
      display: contents;
    }

    [data-browse-title] {
      flex-basis: 100%;
      margin-bottom: 0.5rem;
    }

    [data-browse-group] {
      display: flex;
      flex-wrap: wrap;
      flex-basis: 100%;
      gap: 0.5rem;
      margin: 0;
    }

    [data-browse-group][data-browse-name-only] {
      flex-basis: auto;
    }

    [data-browse-name],
    [data-browse-keyword] {
      display: inline-block;
      max-width: 100%;
      overflow: hidden;
      padding: 0.3125rem 0.875rem;
      border: 1px solid color-mix(in oklab, var(--color-gray-300) 80%, transparent);
      border-radius: 9999px;
      background-color: rgb(255 255 255 / 0.75);
      font-size: 0.875rem;
      line-height: 1.5rem;
      letter-spacing: normal;
      color: var(--color-gray-700);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    [data-browse-name] {
      border-color: transparent;
      background-color: var(--color-gray-200);
      font-weight: 600;
      color: var(--color-gray-900);
    }

    /* "w/" one tone lower, so the co-appearing name reads first. */
    [data-browse-keyword] > span {
      color: var(--color-gray-500);
    }

    @media (prefers-color-scheme: dark) {
      [data-browse-name],
      [data-browse-keyword] {
        border-color: var(--color-gray-700);
        background-color: rgb(0 0 0 / 0.4);
        color: var(--color-gray-300);
      }

      [data-browse-name] {
        border-color: transparent;
        background-color: rgb(255 255 255 / 0.14);
        color: var(--color-gray-100);
      }
    }
  }

  @media (width < 48rem) and (prefers-reduced-motion: reduce) {
    :global([data-browse-close-icon]) {
      transition: none;
    }
  }
</style>

<script>
  import { mountCommissionSearchIsland } from '@features/home/search/commissionSearchIsland'
  import { bindSoftNavMount } from '@lib/astro/softNavMount'

  bindSoftNavMount(mountCommissionSearchIsland)
</script>
