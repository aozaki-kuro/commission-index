---
import type { SearchSuggestionAliasGroup } from '@features/home/search/commissionSearchIndex'
import type { KeywordBrowseGroup } from '@lib/home/keywordBrowseGroups'
import { resolveHomeSearchControls } from '@features/home/i18n/homeSearchControls'
import { Icon } from 'astro-icon/components'

interface Props {
  locale?: string
  featuredKeywords?: string[]
  suggestionAliasGroups?: SearchSuggestionAliasGroup[]
  keywordBrowseSections?: { label: string, groups: KeywordBrowseGroup[] }[]
}

const {
  locale,
  featuredKeywords = [],
  suggestionAliasGroups = [],
  keywordBrowseSections = [],
} = Astro.props

const controls = resolveHomeSearchControls(locale)
const browseTermClass = `
  rounded-sm text-left transition-colors
  hover:text-gray-900 hover:underline hover:underline-offset-3
  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-500
  dark:hover:text-white
  dark:focus-visible:outline-gray-300
`
// The entrance stagger counts rows across both sections, so Archived continues the cascade instead of restarting it.
const browseRowOffsets = keywordBrowseSections.map((_, index) =>
  keywordBrowseSections.slice(0, index).reduce((count, section) => count + section.groups.length, 0))
---

<section
  id="commission-search"
  class="
    mt-4 mb-8
    md:mt-4 md:mb-10
    lg:mt-6 lg:mb-12
  "
  data-locale={locale}
  data-featured-keywords={JSON.stringify(featuredKeywords)}
  data-suggestion-alias-groups={JSON.stringify(suggestionAliasGroups)}
>
  <div class="flex h-12 items-center justify-end">
    <div class="
      relative h-11 w-full overflow-visible border-b border-gray-300/80
      bg-transparent text-gray-700
      dark:border-gray-700 dark:text-gray-300
    "
    >
      {/* Search icon */}
      <Icon
        name="tabler:search"
        aria-hidden="true"
        class="
          absolute top-1/2 left-2.5 size-3.5 shrink-0 -translate-y-1/2
          opacity-70
        "
      />

      <div class="
        absolute inset-y-0 right-2 left-8 flex items-center gap-2
      "
      >
        {/* Combobox wrapper */}
        <div
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-owns="search-suggestion-list"
          class="relative size-full overflow-visible bg-transparent"
        >
          <label for="commission-search-input" class="sr-only">
            {controls.searchCommissions}
          </label>

          <input
            id="commission-search-input"
            type="text"
            value=""
            placeholder={controls.searchPlaceholder}
            autocomplete="off"
            aria-label={controls.searchCommissions}
            class="
              peer m-0 flex h-10 w-[calc(100%/0.875)] origin-left
              scale-[0.875] appearance-none rounded-md bg-transparent p-0
              pr-24 text-base/5 outline-none
              placeholder:text-gray-400
            "
          />

          {/* Suggestion dropdown (starts collapsed, animated open/close by controller) */}
          <ul
            id="search-suggestion-list"
            role="listbox"
            class="
              absolute inset-x-0 top-[calc(100%+0.5rem)] z-20 max-h-[min(70dvh,28rem)]
              overflow-y-auto overscroll-contain rounded-xl border border-white/20
              bg-white/80 py-1 text-sm shadow-[0_8px_30px_rgb(0,0,0,0.12)]
              backdrop-blur-md
              dark:border-gray-700 dark:bg-black/80
              pointer-events-none origin-top scale-y-[0.96] opacity-0
              motion-safe:transition-[opacity,transform] motion-safe:duration-150
              motion-safe:ease-out
              motion-reduce:transition-none
            "
          ></ul>
        </div>

        {/* Help trigger button */}
        <button
          id="search-help-trigger"
          type="button"
          class="
            absolute right-0 inline-flex size-7 items-center justify-center
            rounded-full text-gray-500 transition-[right,color]
            duration-200
            hover:text-gray-900
            focus-visible:outline-2 focus-visible:outline-offset-2
            focus-visible:outline-gray-500
            dark:text-gray-400
            dark:hover:text-gray-100
            dark:focus-visible:outline-gray-300
          "
          aria-label={controls.searchHelp}
          popovertarget="search-help-popover"
        >
          <Icon name="tabler:help-circle" class="size-5" aria-hidden="true" />
        </button>

        {/* Help popover */}
        <div
          id="search-help-popover"
          popover
          class="
            m-auto w-[min(calc(100vw-1rem),26rem)] overflow-auto rounded-lg
            border border-gray-300/80 bg-white/95 p-0 text-gray-700
            shadow-[0_10px_30px_rgba(0,0,0,0.12)] backdrop-blur-sm
            md:text-base
            dark:border-gray-700 dark:bg-black/90 dark:text-gray-300
          "
        >
          <div data-help-content class="space-y-3 p-4">
            <h2 class="
              text-base font-bold text-gray-900
              md:text-lg
              dark:text-gray-100
            "
            >
              {controls.searchHelpTitle}
            </h2>
            <p class="
              text-xs
              md:text-sm
            "
            >
              {controls.searchHelpIntro}
            </p>

            <div class="
              max-h-[min(50dvh,22rem)] overflow-auto rounded-lg border
              border-gray-200/90
              dark:border-gray-700/90
            "
            >
              <table class="
                w-full min-w-[18rem] border-separate border-spacing-0 text-left
                text-xs/relaxed
                md:text-sm
              "
              >
                <thead class="
                  sticky top-0 bg-gray-100/90 text-gray-600
                  dark:bg-gray-800/90 dark:text-gray-300
                "
                >
                  <tr>
                    <th class="px-3 py-2 font-semibold">{controls.searchHelpSyntaxHeader}</th>
                    <th class="px-3 py-2 font-semibold">{controls.searchHelpMeaningHeader}</th>
                  </tr>
                </thead>

                <tbody class="
                  divide-y divide-gray-200/80
                  dark:divide-gray-700/80
                "
                >
                  {controls.searchHelpRows.map(row => (
                    <tr class="align-top">
                      <td class="w-20 px-3 py-2.5">
                        <code class="
                          rounded-sm bg-gray-100 px-1.5 py-0.5 font-mono text-[11px]
                          text-gray-700
                          md:text-xs
                          dark:bg-gray-800 dark:text-gray-200
                        "
                        >
                          {row.syntax}
                        </code>
                      </td>
                      <td class="
                        px-3 py-2.5 text-[11px]
                        sm:text-xs
                        md:text-sm
                      "
                      >
                        <p>{row.description}</p>
                        <p class="
                          mt-0.5 wrap-break-word text-gray-500
                          dark:text-gray-400
                        "
                        >
                          {controls.searchHelpExampleLabel}:
                          {' '}
                          <code class="
                            rounded-sm bg-gray-100 px-1.5 py-0.5 font-mono
                            text-[11px] text-gray-600
                            md:text-xs
                            dark:bg-gray-800 dark:text-gray-300
                          "
                          >
                            {row.example}
                          </code>
                        </p>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="
              text-[11px] wrap-break-word text-gray-500
              sm:text-xs
              md:text-sm
              dark:text-gray-400
            "
            >
              {controls.searchHelpCombinedExampleLabel}:
              {' '}
              <code class="
                rounded-sm bg-gray-100 px-1.5 py-0.5 font-mono text-[11px]
                text-gray-600
                md:text-xs
                dark:bg-gray-800 dark:text-gray-300
              "
              >
                blue hair | silver !sketch
              </code>
            </p>
            <p class="
              text-[11px] wrap-break-word text-gray-500
              sm:text-xs
              md:text-sm
              dark:text-gray-400
            "
            >
              {controls.searchHelpAliasHint}
            </p>
            <div class="flex justify-end">
              <button
                type="button"
                class="
                  rounded-md border border-gray-300/80 bg-white/85 px-3 py-1.5
                  text-xs font-semibold text-gray-700 transition-colors
                  hover:bg-gray-100
                  focus-visible:outline-2 focus-visible:outline-offset-2
                  focus-visible:outline-gray-500
                  dark:border-gray-600 dark:bg-gray-900/80 dark:text-gray-200
                  dark:hover:bg-gray-800
                  dark:focus-visible:outline-gray-300
                "
                popovertarget="search-help-popover"
                popovertargetaction="hide"
              >
                {controls.searchHelpClose}
              </button>
            </div>
          </div>
        </div>

        {/* Copy URL button (hidden until query exists) */}
        <button
          id="search-copy-url"
          type="button"
          class="
            absolute right-8 inline-flex size-7 items-center justify-center
            rounded-full text-gray-500 transition-[opacity,color] duration-150
            pointer-events-none opacity-0
            hover:text-gray-900
            focus-visible:outline-2 focus-visible:outline-offset-2
            focus-visible:outline-gray-500
            dark:text-gray-400
            dark:hover:text-gray-100
            dark:focus-visible:outline-gray-300
          "
          aria-label={controls.copySearchUrl}
        >
          {/* Share icon (visible by default) */}
          <Icon name="tabler:share-3" data-icon="share" class="size-4.5" aria-hidden="true" />
          {/* Check icon (hidden, shown on copy success) */}
          <Icon name="tabler:check" data-icon="check" class="size-4.5 hidden" aria-hidden="true" />
        </button>

        {/* Clear button (hidden until query exists) */}
        <button
          id="search-clear"
          type="button"
          class="
            absolute right-0 inline-flex size-7 items-center justify-center
            rounded-full text-gray-500 transition-[opacity,color]
            pointer-events-none opacity-0
            hover:text-gray-900
            focus-visible:outline-2 focus-visible:outline-offset-2
            focus-visible:outline-gray-500
            dark:text-gray-400
            dark:hover:text-gray-100
            dark:focus-visible:outline-gray-300
          "
          aria-label={controls.clearSearch}
        >
          <Icon name="tabler:x" class="size-5" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>

  {/* Popular keywords row (invisible to reserve space, fades in when populated) */}
  <div
    id="search-popular-keywords"
    class="
      mt-2 flex min-h-8 w-full items-center gap-2 overflow-hidden pr-2 text-xs
      text-gray-500 invisible opacity-0
      motion-safe:transition-[visibility,opacity] motion-safe:duration-200 motion-safe:ease-out
      dark:text-gray-400
    "
  >
    <ul
      id="search-keyword-list"
      class="
        flex min-w-0 flex-1 flex-nowrap items-center gap-1.5 overflow-x-auto
        pr-0.5
      "
    />
    <div class="flex shrink-0 gap-1.5">
      {/* Shuffle / surprise me button */}
      <button
        id="search-shuffle"
        type="button"
        class="
          size-7 shrink-0 rounded-full border border-gray-200/80 bg-white/70
          text-gray-500 shadow-[0_1px_2px_rgba(0,0,0,0.04)]
          transition-[color,border-color,background-color,box-shadow] duration-200
          hover:border-gray-400 hover:bg-white hover:text-gray-900
          hover:shadow-[0_4px_14px_rgba(0,0,0,0.08)]
          dark:border-gray-700 dark:bg-black/35 dark:text-gray-400
          dark:hover:border-gray-500 dark:hover:bg-black/55
          dark:hover:text-gray-100 dark:hover:shadow-[0_4px_14px_rgba(0,0,0,0.22)]
          inline-flex items-center justify-center
        "
        aria-label={controls.shuffleRandomEntryLabel}
      >
        <Icon name="tabler:arrows-shuffle" class="size-4" aria-hidden="true" />
      </button>

      {/* Opens the full character/keyword list; the row above only shows the featured few */}
      {keywordBrowseSections.length > 0 && (
        <button
          id="search-browse-trigger"
          type="button"
          popovertarget="search-browse-popover"
          class="
            inline-flex h-7 shrink-0 items-center gap-0.5 rounded-full border
            border-gray-200/80 bg-white/70 pr-2 pl-2.5 text-[11px] text-gray-600
            shadow-[0_1px_2px_rgba(0,0,0,0.04)]
            transition-[color,border-color,background-color,box-shadow] duration-200
            hover:border-gray-400 hover:bg-white hover:text-gray-900
            hover:shadow-[0_4px_14px_rgba(0,0,0,0.08)]
            dark:border-gray-700 dark:bg-black/35 dark:text-gray-300
            dark:hover:border-gray-500 dark:hover:bg-black/55
            dark:hover:text-gray-100
            dark:hover:shadow-[0_4px_14px_rgba(0,0,0,0.22)]
          "
        >
          {controls.browseKeywordsLabel}
          <Icon name="tabler:chevron-down" class="size-3.5" aria-hidden="true" />
        </button>
      )}
    </div>
  </div>

  {/* Browse popover: outside the keyword row, whose hidden-until-populated visibility would inherit into it */}
  {keywordBrowseSections.length > 0 && (
    <div
      id="search-browse-popover"
      popover
      role="dialog"
      aria-label={controls.browseKeywordsLabel}
      class="
        m-auto max-h-[min(70dvh,34rem)] w-[min(calc(100vw-1rem),36rem)]
        overflow-auto overscroll-contain rounded-xl border border-gray-200/80 bg-white/80 p-0 max-md:bg-white/90
        shadow-[0_10px_30px_rgba(0,0,0,0.12)] backdrop-blur-xl backdrop-saturate-180
        dark:border-gray-800 dark:bg-[rgb(29_29_31/0.8)]
      "
    >
      {/* Hierarchy comes from type size and tone alone, like apple.com's nav flyout: no dividers, chips or icons */}
      <div class="
        grid gap-x-8 gap-y-10 px-6 pt-5
        pb-[max(1rem,env(safe-area-inset-bottom))]
        md:grid-cols-2
      "
      >
        {keywordBrowseSections.map((section, sectionIndex) => (
          <section>
            <h2 class="
              mb-3.5 text-xs font-normal tracking-wider text-gray-500 uppercase
              dark:text-gray-500
            "
            >
              {section.label}
            </h2>
            <ul class="space-y-5">
              {section.groups.map((group, groupIndex) => (
                <li
                  data-browse-row
                  style={`--i: ${browseRowOffsets[sectionIndex] + groupIndex}`}
                >
                  <button
                    type="button"
                    data-browse-term={group.character}
                    class={`${browseTermClass} text-[17px]/tight font-semibold tracking-tight text-gray-900 dark:text-gray-100`}
                  >
                    {group.character}
                  </button>
                  {(group.coCharacters.length > 0 || group.keywords.length > 0) && (
                    <ul class="
                      mt-1.5 flex flex-wrap gap-x-3 gap-y-0.5 text-sm/6 text-gray-700
                      dark:text-gray-300
                    "
                    >
                      {/* A co-appearance ("w/ Name") searches both characters, so it finds the shared works instead of everything of the other */}
                      {group.coCharacters.map(coCharacter => (
                        <li>
                          <button
                            type="button"
                            data-browse-term={coCharacter}
                            data-browse-scope={group.character}
                            aria-label={`${group.character} ${coCharacter}`}
                            class={browseTermClass}
                          >
                            <span aria-hidden="true">w/</span>
                            {' '}
                            {coCharacter}
                          </button>
                        </li>
                      ))}
                      {group.keywords.map(keyword => (
                        <li>
                          <button type="button" data-browse-term={keyword} class={browseTermClass}>
                            {keyword}
                          </button>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  )}

  {/* Live region for screen reader announcements */}
  <p id="search-live-region" aria-live="polite" class="sr-only" />
</section>

<style>
  #search-help-popover {
    --search-help-width: min(calc(100vw - 1rem), 26rem);
    max-height: calc(100dvh - 1rem);
  }

  #search-browse-popover {
    --search-browse-width: min(calc(100vw - 1rem), 36rem);
  }

  #search-help-popover,
  #search-browse-popover {
    opacity: 0;
    transform: scale(0.97);
    transform-origin: top right;
    transition:
      opacity 120ms ease-in,
      transform 120ms ease-in,
      display 120ms allow-discrete,
      overlay 120ms allow-discrete;
  }

  #search-help-popover:popover-open,
  #search-browse-popover:popover-open {
    opacity: 1;
    transform: scale(1);
    transition-duration: 180ms;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  @starting-style {
    #search-help-popover:popover-open,
    #search-browse-popover:popover-open {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  @supports (position-anchor: --search-help) {
    #search-help-trigger {
      anchor-name: --search-help;
    }

    #search-help-popover {
      position-anchor: --search-help;
      inset: auto;
      top: calc(anchor(bottom) + 0.5rem);
      right: clamp(0.5rem, anchor(right), calc(100vw - var(--search-help-width) - 0.5rem));
      margin: 0;
      position-try-fallbacks: flip-block, --search-help-constrained;
    }

    /* Keep the close control reachable when neither side has room for the full panel. */
    @position-try --search-help-constrained {
      bottom: 0.5rem;
      height: auto;
    }
  }

  @supports (position-anchor: --search-browse) {
    #search-browse-trigger {
      anchor-name: --search-browse;
    }

    #search-browse-popover {
      position-anchor: --search-browse;
      inset: auto;
      top: calc(anchor(bottom) + 0.5rem);
      right: clamp(0.5rem, anchor(right), calc(100vw - var(--search-browse-width) - 0.5rem));
      margin: 0;
      position-try-fallbacks: flip-block;
    }
  }

  /* Narrow screens get a bottom sheet instead of an anchored popover (Apple HIG: no popovers in compact width). */
  @media (width < 48rem) {
    /* A full-height sheet (iOS large detent) with the hamburger menu's material, so both mobile surfaces match. */
    #search-browse-popover {
      inset: 2.5rem 0 0;
      width: 100%;
      max-height: none;
      margin: 0;
      border-width: 1px 0 0;
      border-radius: 1rem 1rem 0 0;
      transform: translateY(100%);
      opacity: 1;
      position-try-fallbacks: none;
    }

    #search-browse-popover:popover-open {
      transform: translateY(0);
    }

    @starting-style {
      #search-browse-popover:popover-open {
        transform: translateY(100%);
        opacity: 1;
      }
    }

    /* Only the sheet dims and frosts the page; on wider screens the panel is a local popover with its own material,
       like a macOS menu, so the search row stays crisp. Values follow apple.com's nav curtain. */
    #search-browse-popover::backdrop {
      background: rgb(0 0 0 / 0);
      backdrop-filter: blur(0);
      transition:
        background 180ms ease,
        backdrop-filter 180ms ease,
        display 180ms allow-discrete,
        overlay 180ms allow-discrete;
    }

    #search-browse-popover:popover-open::backdrop {
      background: rgb(0 0 0 / 0.15);
      backdrop-filter: blur(20px);
    }

    @media (prefers-color-scheme: dark) {
      #search-browse-popover:popover-open::backdrop {
        background: rgb(0 0 0 / 0.4);
      }
    }

    @starting-style {
      #search-browse-popover:popover-open::backdrop {
        background: rgb(0 0 0 / 0);
        backdrop-filter: blur(0);
      }
    }
  }

  /* Character rows cascade in on open like apple.com's nav flyout (its 0.32s, 80ms + 20ms per row, 4px drop).
     The closed popover is display: none, so @starting-style replays on every open; closing stays a flat fade. */
  [data-browse-row] {
    transition:
      opacity 320ms cubic-bezier(0.4, 0, 0.6, 1),
      transform 320ms cubic-bezier(0.4, 0, 0.6, 1);
    transition-delay: calc(80ms + min(var(--i, 0), 12) * 20ms);
  }

  @starting-style {
    #search-browse-popover:popover-open [data-browse-row] {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-browse-row] {
      transition-property: opacity;
      transition-delay: 0ms;
    }
  }
</style>

<script>
  import { mountCommissionSearchIsland } from '@features/home/search/commissionSearchIsland'
  import { bindSoftNavMount } from '@lib/astro/softNavMount'

  bindSoftNavMount(mountCommissionSearchIsland)
</script>
