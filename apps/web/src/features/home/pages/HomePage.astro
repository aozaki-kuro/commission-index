---
import { getCharacterAliases } from '@data/characterAliases'
import { getHomeFeaturedSearchKeywords } from '@data/homeFeaturedSearchKeywords'
import { getKeywordAliases } from '@data/keywordAliases'
import CommissionDescription from '@features/home/blocks/Description.astro'
import Footer from '@features/home/blocks/Footer.astro'
import CommissionImageNoticeScript from '@features/home/commission/CommissionImageNoticeScript.astro'
import MobileViewModeTabs from '@features/home/commission/MobileViewModeTabs.astro'
import HomeClientScript from '@features/home/HomeClientScript.astro'
import {
  getHomeLocaleMessages,
  HOME_LOCALE_SWITCH_ITEMS,
  normalizeHomeLocale,
} from '@features/home/i18n/homeLocale'
import DesktopSidebarNav from '@features/home/nav/DesktopSidebarNav.astro'
import MobileHamburgerMenu from '@features/home/nav/hamburger/MobileHamburgerMenu.astro'
import MobileLanguageMenu from '@features/home/nav/hamburger/MobileLanguageMenu.astro'
import CommissionSearchIsland from '@features/home/search/CommissionSearchIsland.astro'
import StaticCommissionSections from '@features/home/server/StaticCommissionSections.astro'
import {
  AGE_CONFIRM_DURATION,
  CONFIRMED_AGE_KEY,
  LIGHTHOUSE_USER_AGENT_TOKEN,
} from '@features/home/warning/ageGate'
import AgeGateScript from '@features/home/warning/AgeGateScript.astro'
import BaseLayout from '@layouts/BaseLayout.astro'
import { normalizeCharacterAliasKey } from '@lib/characterAliases'
import { buildSitePayload } from '@lib/home/buildSitePayload'
import { buildHomeUpdateSummary } from '@lib/home/updateSummary'
import { listMissingSourceImages, resolveSourceImageByCommissionId } from '@lib/images/sourceImageRegistry'
import { normalizeKeywordAliasKey } from '@lib/keywordAliases'
import { buildCommissionDataMap, buildCreatorAliasesMap } from '@lib/sitePayload'
import { getImage } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface HomePageProps {
  locale?: string
  canonicalPath?: string
}

const { locale, canonicalPath } = Astro.props as HomePageProps
const resolvedLocale = normalizeHomeLocale(locale)
const messages = getHomeLocaleMessages(resolvedLocale)
const localeOptions = HOME_LOCALE_SWITCH_ITEMS.map(item => ({
  locale: item.locale,
  label: item.label,
  href: getRelativeLocaleUrl(item.locale),
}))

const payload = buildSitePayload()
const homeUpdateSummary = buildHomeUpdateSummary(payload.commissionData, payload.activeCharacterNames)
const featuredSearchKeywords = getHomeFeaturedSearchKeywords()
const characterAliases = getCharacterAliases()
const keywordAliases = getKeywordAliases()
const commissionMap = buildCommissionDataMap(payload.commissionData)
const creatorAliasesMap = buildCreatorAliasesMap(payload.creatorAliases)
const characterAliasesMap = new Map(
  characterAliases
    .map((row) => {
      const key = normalizeCharacterAliasKey(row.characterName)
      if (!key)
return null
      return [key, row.aliases] as const
    })
    .filter((entry): entry is readonly [string, string[]] => Boolean(entry)),
)
const keywordAliasesMap = new Map(
  keywordAliases
    .map((row) => {
      const key = normalizeKeywordAliasKey(row.baseKeyword)
      if (!key)
return null
      return [key, row.aliases] as const
    })
    .filter((entry): entry is readonly [string, string[]] => Boolean(entry)),
)
const suggestionAliasGroups = [
  ...characterAliases.map(row => ({
    term: row.characterName,
    aliases: row.aliases,
  })),
  ...payload.creatorAliases.map(row => ({
    term: row.creatorName,
    aliases: row.aliases,
  })),
  ...keywordAliases.map(row => ({
    term: row.baseKeyword,
    aliases: row.aliases,
  })),
]
const COMMISSION_IMAGE_SIZES = '(max-width: 768px) 92vw, 640px'

const commissions = payload.commissionData.flatMap(character => character.Commissions)
const missingSourceImages = listMissingSourceImages(commissions)

if (missingSourceImages.length > 0) {
  const message = `Missing source images for ${missingSourceImages.length} commissions: ${missingSourceImages.join(', ')}`

  if (import.meta.env.DEV) {
    console.warn(`[images] ${message}`)
  }
 else {
    throw new Error(message)
  }
}

const firstCharacterName
  = payload.characterStatus.active[0]?.DisplayName ?? payload.characterStatus.archived[0]?.DisplayName
const firstCommission = firstCharacterName
  ? commissionMap.get(firstCharacterName)?.Commissions?.[0]
  : undefined
const firstSourceImage = firstCommission
  ? resolveSourceImageByCommissionId(firstCommission.id)
  : null

const priorityImage = firstSourceImage
  ? (() =>
      getImage({
        src: firstSourceImage,
        widths: [768, 960, 1280],
        format: 'webp',
        sizes: COMMISSION_IMAGE_SIZES,
      }).then(image => ({
        src: image.src,
        srcSet: image.srcSet.attribute,
        sizes: COMMISSION_IMAGE_SIZES,
      })))()
  : undefined

const resolvedCanonicalPath
  = canonicalPath ?? (resolvedLocale === 'en' ? '/' : `/${resolvedLocale}/`)
---

<BaseLayout priorityImage={await priorityImage} lang={messages.lang} canonicalPath={resolvedCanonicalPath}>
  <style is:global slot="head">
    html[data-home-scroll-restoring='true'] [data-home-scroll-restore-shell='true'],
    html[data-home-hash-restoring='true'] [data-home-scroll-restore-shell='true'] {
      opacity: 0;
      pointer-events: none;
    }
  </style>
  <script
    is:inline
    slot="head"
    define:vars={{ confirmedKey: CONFIRMED_AGE_KEY, confirmDuration: AGE_CONFIRM_DURATION, lighthouseToken: LIGHTHOUSE_USER_AGENT_TOKEN }}
  >
    // Mirrors hasValidAgeConfirmation() in warning/ageGate.ts: show the gate in the first frame
    // instead of waiting for the module script. On storage errors stay closed, as the module does.
    try {
      if (!navigator.userAgent.toLowerCase().includes(lighthouseToken)) {
        const confirmedAt = Number(localStorage.getItem(confirmedKey))
        if (!(confirmedAt && Date.now() - confirmedAt < confirmDuration)) {
          document.documentElement.dataset.ageGateInitial = 'open'
          document.documentElement.dataset.ageGateOpen = 'true'
        }
      }
    }
    catch {
      // Storage unavailable: leave the gate to the module script.
    }
  </script>
  <script is:inline slot="head">
    try {
      const rawState = window.sessionStorage.getItem('home:scroll-state')
      if (!rawState || window.location.hash) {
        // noop
      }
      else {
        const navigationEntry = window.performance.getEntriesByType('navigation')[0]
        const navigationType
          = navigationEntry && 'type' in navigationEntry ? String(navigationEntry.type) : ''
        const parsedState = JSON.parse(rawState)

        if (
          navigationType === 'reload'
          && parsedState
          && parsedState.pathname === window.location.pathname
          && parsedState.search === window.location.search
        ) {
          document.documentElement.dataset.homeScrollRestoring = 'true'

          try {
            window.history.scrollRestoration = 'manual'
          }
          catch {
            // Ignore unsupported browsers.
          }
        }
      }
    }
    catch {
      // Ignore malformed session state and allow the page to render normally.
    }
    // Hide shell when hash targets deferred content not yet in DOM.
    // Loaders reveal after loading the batch and scrolling; 3 s fallback.
    try {
      const hashId = window.location.hash ? window.location.hash.slice(1) : ''
      if (hashId && !document.getElementById(hashId)) {
        document.documentElement.dataset.homeHashRestoring = 'true'
        window.__homeHashRestoreTimer = setTimeout(() => {
          delete document.documentElement.dataset.homeHashRestoring
        }, 3000)
      }
    }
    catch {
      // Ignore hash detection failure and allow normal render.
    }
  </script>
  <AgeGateScript locale={resolvedLocale} />
  <CommissionDescription
    locale={resolvedLocale}
    commissionData={payload.commissionData}
    activeCharacters={payload.activeCharacterNames}
    updateSummary={homeUpdateSummary}
  />
  <div class="relative mx-auto flex justify-center">
    <div id="Main Contents" class="w-full max-w-2xl">
      <CommissionSearchIsland
        locale={resolvedLocale}
        featuredKeywords={featuredSearchKeywords}
        suggestionAliasGroups={suggestionAliasGroups}
      />
      <MobileHamburgerMenu
        active={payload.characterStatus.active}
        archived={payload.characterStatus.archived}
        monthNavItems={payload.monthNavItems}
        controls={messages.controls}
      />
      <MobileLanguageMenu
        locale={resolvedLocale}
        localeOptions={localeOptions}
        localeSwitcherLabel={messages.localeSwitcherLabel}
      />
      <MobileViewModeTabs
        byCharacterLabel={messages.controls.byCharacter}
        byDateLabel={messages.controls.byDate}
      />
      <DesktopSidebarNav
        locale={resolvedLocale}
        localeOptions={localeOptions}
        localeSwitcherLabel={messages.localeSwitcherLabel}
        controls={messages.controls}
        active={payload.characterStatus.active}
        archived={payload.characterStatus.archived}
        monthNavItems={payload.monthNavItems}
      />
      <div data-home-scroll-restore-shell="true">
        <CommissionImageNoticeScript />
        <StaticCommissionSections
          locale={resolvedLocale}
          activeChars={payload.characterStatus.active}
          archivedChars={payload.characterStatus.archived}
          commissionMap={commissionMap}
          characterAliasesMap={characterAliasesMap}
          creatorAliasesMap={creatorAliasesMap}
          keywordAliasesMap={keywordAliasesMap}
          timelineGroups={payload.timelineGroups}
        />
        <HomeClientScript />
        <Footer locale={resolvedLocale} />
      </div>
    </div>
  </div>
</BaseLayout>
