---
import type { HomeLocaleMessages, HomeLocaleOption } from '@features/home/i18n/homeLocale'
import type { CharacterNavItem } from '@lib/characters/nav'
import { STYLES } from '@features/home/nav/hamburger/constants'
import { buildCharacterNavItems } from '@lib/characters/nav'
import { Icon } from 'astro-icon/components'

interface CharacterDisplay {
  DisplayName: string
}

interface DesktopSidebarNavProps {
  active: CharacterDisplay[]
  archived: CharacterDisplay[]
  monthNavItems: CharacterNavItem[]
  locale: string
  localeOptions: HomeLocaleOption[]
  localeSwitcherLabel: string
  controls: HomeLocaleMessages['controls']
}

const { active, archived, monthNavItems, locale, localeOptions, localeSwitcherLabel, controls }
  = Astro.props as DesktopSidebarNavProps

const activeCharacterNavItems = buildCharacterNavItems(active)
const archivedCharacterNavItems = buildCharacterNavItems(archived)
const sidebarLeadSlotClass = 'flex h-5 w-4 shrink-0 items-center justify-center'
const sidebarIconClass = 'h-3.5 w-3.5'
const sidebarLeadOffsetStyle = '--sidebar-lead-offset:1.125rem;'
// Sidebar links and toggles share one ink and hover only through the site link opacity (`a`/`data-link-style`); a
// color hover or transition-colors on them would stack on that fade. Anchors inherit the ink from their `li` or
// wrapper (the link rule only inherits color), and the `li` sets it because the base `p, li` rule would win otherwise.
// The sidebar stays a step lighter than body text: it sits beside the listing the whole time, unlike the full-screen
// hamburger panel.
const sidebarLabelClass = 'text-sm leading-5 font-bold no-underline'
const sidebarNavLinkClass
  = `flex items-center gap-2 text-sm no-underline mb-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-500 dark:focus-visible:outline-gray-400 rounded-sm`
---

<aside
  id="Home Controls"
  class="
    hidden
    md:top-52 md:right-[calc(50%+22rem)] md:bottom-0 md:w-full
    md:max-w-[calc(10rem+var(--sidebar-lead-offset))]
    lg:fixed lg:z-20 lg:block
  "
  style={`${sidebarLeadOffsetStyle} animation: reveal-up 500ms cubic-bezier(0.22, 1, 0.36, 1) backwards;`}
>
  <div class="sticky top-4 space-y-2">
    <div class="space-y-4 pb-2">
      <div class="
        flex min-h-5 items-center gap-2 text-gray-700
        dark:text-gray-200
      "
      >
        <span class={sidebarLeadSlotClass} aria-hidden="true">
          <Icon name="tabler:search" class={`${sidebarIconClass} text-gray-400 transition-colors duration-300`} aria-hidden="true" />
        </span>
        <a
          href="#commission-search"
          data-sidebar-search-link="true"
          class={`${sidebarLabelClass} rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-500 dark:focus-visible:outline-gray-400`}
        >
          {controls.search}
        </a>
      </div>

      <details data-sidebar-locale-menu class="group">
        <summary
          data-link-style="true"
          class="
            flex min-h-5 list-none items-center gap-2
            text-gray-700 no-underline
            dark:text-gray-200
          "
          aria-label={localeSwitcherLabel}
        >
          <span class={sidebarLeadSlotClass} aria-hidden="true">
            <Icon name="tabler:chevron-right" class={`${sidebarIconClass} text-gray-400 transition-transform duration-200 group-open:rotate-90`} aria-hidden="true" />
          </span>
          <span class={sidebarLabelClass}>{localeSwitcherLabel}</span>
        </summary>

        <div data-sidebar-disclosure-clip class="overflow-hidden">
          <ul class="space-y-2 *:first:mt-3">
            {
              localeOptions.map((option) => {
                const isActive = option.locale === locale
                return (
                  <li class={`
                    text-gray-700
                    dark:text-gray-200
                  `}
                  >
                    <a
                      href={option.href}
                      aria-current={isActive ? 'page' : undefined}
                      class={sidebarNavLinkClass}
                    >
                      <span class={sidebarLeadSlotClass} aria-hidden="true">
                        <span class={`
                          size-1.5 rounded-full bg-gray-500/80 transition-[opacity,scale] duration-300
                          dark:bg-gray-300/80
                          ${isActive ? 'scale-100 opacity-100' : 'scale-95 opacity-0'}
                        `}
                        />
                      </span>
                      {option.label}
                    </a>
                  </li>
                )
              })
            }
          </ul>
        </div>
      </details>

      <div class="space-y-2">
        <button
          type="button"
          data-sidebar-view-mode-toggle="true"
          data-view-mode="character"
          aria-pressed="true"
          data-link-style="true"
          class="
            flex min-h-5 w-full appearance-none items-center
            gap-2 border-0 bg-transparent p-0 text-left text-gray-900
            no-underline
            dark:text-white
          "
        >
          <span class={sidebarLeadSlotClass} aria-hidden="true">
            <Icon data-sidebar-view-mode-indicator name="tabler:arrow-badge-right-filled" class="size-4 scale-100 text-gray-400 opacity-100 transition-[opacity,scale] duration-300" aria-hidden="true" />
          </span>
          <span class={sidebarLabelClass}>
            {controls.byCharacter}
          </span>
        </button>

        <button
          type="button"
          data-sidebar-view-mode-toggle="true"
          data-view-mode="timeline"
          aria-pressed="false"
          data-link-style="true"
          class="
            flex min-h-5 w-full appearance-none items-center
            gap-2 border-0 bg-transparent p-0 text-left text-gray-700
            no-underline
            dark:text-gray-200
          "
        >
          <span class={sidebarLeadSlotClass} aria-hidden="true">
            <Icon data-sidebar-view-mode-indicator name="tabler:arrow-badge-right-filled" class="size-4 scale-95 text-gray-400 opacity-0 transition-[opacity,scale] duration-300" aria-hidden="true" />
          </span>
          <span class={sidebarLabelClass}>
            {controls.byDate}
          </span>
        </button>
      </div>

    </div>

  </div>
</aside>

{/* Fill `backwards`, not `both`: a retained transform makes this aside the containing block of the fixed back-to-top
    button and pushes it off-screen. */}
<aside
  id="Character List"
  class="
    hidden
    md:top-52 md:left-[calc(50%+22rem)] md:bottom-0 md:w-full
    md:max-w-[calc(12.5rem+var(--sidebar-lead-offset))]
    lg:fixed lg:z-20 lg:block
  "
  style={`${sidebarLeadOffsetStyle} animation: reveal-up 500ms cubic-bezier(0.22, 1, 0.36, 1) 120ms backwards;`}
>
  <div class="sticky top-4 space-y-2 pl-12">
    <nav>
      <ul data-sidebar-nav-panel="character" class="space-y-2">
        {
          activeCharacterNavItems.length > 0
? (
            <li>
              <div class="
                flex min-h-5 items-center gap-2 pb-1 text-gray-700
                dark:text-gray-200
              "
              >
                <span class={sidebarLeadSlotClass} aria-hidden="true">
                  <Icon name="tabler:flare" class={`${sidebarIconClass} text-gray-400`} aria-hidden="true" />
                </span>
                <span class="text-sm/5 font-bold">{controls.activeCharacters}</span>
              </div>
            </li>
          )
: null
        }
        {
          activeCharacterNavItems.map(({ displayName, sectionHash, titleId, sectionId }) => (
            <li class="
              text-gray-700
              dark:text-gray-200
            "
            >
              <a
                href={sectionHash}
                data-sidebar-character-link="true"
                data-sidebar-character-status="active"
                data-sidebar-title-id={titleId}
                class={sidebarNavLinkClass}
                data-sidebar-section-id={sectionId}
              >
                <span class={sidebarLeadSlotClass} aria-hidden="true">
                  <span
                    data-sidebar-dot-for={titleId}
                    class="
                      size-1.5 scale-95 rounded-full bg-gray-400 opacity-0
                      transition-[opacity,scale] duration-300
                    "
                  />
                </span>
                {displayName}
              </a>
            </li>
          ))
        }
        {
          archivedCharacterNavItems.length > 0
? (
            <li class="pt-2">
              <details class="group" data-sidebar-archived-details="true">
                <summary
                  data-load-archived-characters="true"
                  data-link-style="true"
                  class="
                    flex min-h-5 list-none items-center gap-2
                    text-gray-700 no-underline
                    dark:text-gray-200
                  "
                >
                  <span class={sidebarLeadSlotClass} aria-hidden="true">
                    <Icon name="tabler:chevron-right" class={`${sidebarIconClass} text-gray-400 transition-transform duration-200 group-open:rotate-90`} aria-hidden="true" />
                  </span>
                  <span class="text-sm/5 font-bold">{controls.archivedCharacters}</span>
                </summary>

                <div data-sidebar-disclosure-clip class="overflow-hidden">
                  <ul class="space-y-2 *:first:mt-4">
                    {
                      archivedCharacterNavItems.map(({ displayName, sectionHash, titleId, sectionId }) => (
                        <li class="
                          text-gray-700
                          dark:text-gray-200
                        "
                        >
                          <a
                            href={sectionHash}
                            data-sidebar-character-link="true"
                            data-sidebar-character-status="archived"
                            data-sidebar-title-id={titleId}
                            class={sidebarNavLinkClass}
                            data-sidebar-section-id={sectionId}
                          >
                            <span class={sidebarLeadSlotClass} aria-hidden="true">
                              <span
                                data-sidebar-dot-for={titleId}
                                class="
                                  size-1.5 scale-95 rounded-full bg-gray-400
                                  opacity-0 transition-[opacity,scale] duration-300
                                "
                              />
                            </span>
                            {displayName}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </details>
            </li>
          )
: null
        }
      </ul>

      <ul data-sidebar-nav-panel="timeline" class="hidden space-y-2">
        <li>
          <div class="
            flex min-h-5 items-center gap-2 pb-1 text-gray-700
            dark:text-gray-200
          "
          >
            <span class={sidebarLeadSlotClass} aria-hidden="true">
              <Icon name="tabler:timeline" class="size-4 text-gray-400" aria-hidden="true" />
            </span>
            <span class="text-sm/5 font-bold">{controls.timelineTitle}</span>
          </div>
        </li>
        {
          monthNavItems.map(({ displayName, sectionHash, titleId, sectionId }) => (
            <li class="
              text-gray-700
              dark:text-gray-200
            "
            >
              <a
                href={sectionHash}
                data-sidebar-character-link="true"
                data-sidebar-character-status="active"
                data-sidebar-title-id={titleId}
                class={sidebarNavLinkClass}
                data-sidebar-section-id={sectionId}
              >
                <span class={sidebarLeadSlotClass} aria-hidden="true">
                  <span
                    data-sidebar-dot-for={titleId}
                    class="
                      size-1.5 scale-95 rounded-full bg-gray-400 opacity-0
                      transition-[opacity,scale] duration-300
                    "
                  />
                </span>
                {displayName}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div
    class="
      pointer-events-none fixed bottom-8 left-[calc(50%+22rem)] z-30 hidden
      w-full max-w-[calc(12.5rem+var(--sidebar-lead-offset))]
      lg:block
    "
    style={sidebarLeadOffsetStyle}
  >
    <div class="pl-12">
      <button
        type="button"
        data-sidebar-back-to-top-button="true"
        aria-label={controls.backToTop}
        title={controls.backToTop}
        class={`${STYLES.floatingButton} pointer-events-none translate-y-1 opacity-0`}
      >
        <Icon name="tabler:chevron-up" class="size-5" aria-hidden="true" />
        <span class="sr-only">{controls.backToTop}</span>
      </button>
    </div>
  </div>
</aside>

<style>
  /* The shared floating-button recipe only transitions its hover; the show/hide toggled by sidebarNavEnhancer.ts needs
     opacity and `translate` (what Tailwind 4's translate-y-* sets, not `transform`). Unlayered, so it beats the
     recipe's transition utilities instead of racing them on class order. */
  [data-sidebar-back-to-top-button] {
    transition:
      opacity 220ms ease-out,
      translate 220ms ease-out,
      background-color 300ms,
      box-shadow 300ms;
  }

  /* Both sidebar disclosures slide open and shut through sidebarDisclosureSlide.ts (transform/opacity, never a height
     or grid-row transition, which WebKit lays out every frame). A closing list stays rendered under `data-closing`
     until its slide settles. The list's top gap sits on its first item, inside the clip box. */
  details[data-closing]::details-content {
    content-visibility: visible;
  }
</style>
