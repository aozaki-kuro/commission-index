---
import { STYLES } from '@features/home/nav/hamburger/constants'
import { Icon } from 'astro-icon/components'

interface MobileKeywordButtonProps {
  label: string
}

const { label } = Astro.props as MobileKeywordButtonProps
---

{/* Keyword chips are the most used mobile action, so the browse panel gets the floating spot above the hamburger;
    language (~1% of mobile sessions) lives at the end of the hamburger menu. */}
<div
  data-mobile-keyword-button-root="true"
  class="
    pointer-events-none fixed right-8 bottom-8 z-90 size-10 opacity-100
    transition-[opacity,translate] duration-200
    data-[floating-hidden]:translate-y-[calc(100%+2rem)] data-[floating-hidden]:opacity-0
    data-[floating-hidden]:*:pointer-events-none
    motion-reduce:data-[floating-hidden]:translate-y-0
    lg:hidden
  "
>
  <div
    data-mobile-keyword-button-anchor="true"
    class="pointer-events-auto absolute right-0 bottom-[calc(100%+0.75rem)]"
  >
    <button
      type="button"
      popovertarget="search-browse-popover"
      aria-label={label}
      class={STYLES.floatingButton}
    >
      <Icon name="tabler:tags" class="size-5" aria-hidden="true" />
    </button>
  </div>
</div>
