---
import type { HomeLocaleMessages } from '@features/home/i18n/homeLocale'
import type { CharacterNavItem } from '@lib/characters/nav'
import { STYLES } from '@features/home/nav/hamburger/constants'
import { buildCharacterNavItems } from '@lib/characters/nav'
import { Icon } from 'astro-icon/components'

interface CharacterDisplay {
  DisplayName: string
}

interface MobileHamburgerMenuProps {
  active: CharacterDisplay[]
  archived: CharacterDisplay[]
  monthNavItems: CharacterNavItem[]
  controls: HomeLocaleMessages['controls']
}

const { active, archived, monthNavItems, controls } = Astro.props as MobileHamburgerMenuProps
const activeNavItems = buildCharacterNavItems(active)
const archivedNavItems = buildCharacterNavItems(archived)
const backdropStyle = {
  WebkitBackdropFilter: STYLES.backdrop,
  backdropFilter: STYLES.backdrop,
}

// Type follows apple.com's mobile menu: every link is one 28px/600 row in one ink; only group labels are smaller.
// Row size comes from --menu-font/--menu-pad (scoped CSS below), so the default view fits the screen.
const utilityActionButtonClassName
  = 'inline-flex items-center gap-3 py-(--menu-pad) text-gray-700 transition-colors duration-150 hover:text-gray-900 dark:text-gray-200 dark:hover:text-white'
const utilityActionTextClassName = 'text-(length:--menu-font) leading-[1.15] font-semibold tracking-[0.007em] no-underline'
const sectionToggleClassName = 'mt-8 mb-1 flex items-center gap-1.5 text-left text-[17px]/[21px] font-normal text-gray-500 transition-colors duration-150 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white'
// Rows fade in top to bottom on open; `--i` drives the stagger delay in the scoped CSS below.
const rowStyle = (index: number) => `--i: ${index}`
const archivedToggleRow = 4 + activeNavItems.length
---

<div
  data-mobile-hamburger="true"
  data-mobile-hamburger-mounted="false"
  data-mobile-hamburger-open="false"
  data-mobile-hamburger-open-label={controls.openNavigationMenu}
  data-mobile-hamburger-close-label={controls.closeNavigationMenu}
  class="
    fixed right-8 bottom-8 z-90
    transition-[opacity,translate] duration-200
    data-[floating-hidden]:translate-y-[calc(100%+2rem)] data-[floating-hidden]:opacity-0
    data-[floating-hidden]:pointer-events-none data-[floating-hidden]:*:pointer-events-none
    motion-reduce:data-[floating-hidden]:translate-y-0
    lg:hidden
  "
>
  {/* The full-screen panel covers this; it stays as the dismiss target behind it. */}
  <button
    type="button"
    data-mobile-hamburger-backdrop="true"
    aria-label={controls.closeNavigationMenu}
    class="pointer-events-none fixed inset-0 z-60 hidden opacity-0"
  />

  <button
    type="button"
    data-mobile-hamburger-toggle="true"
    style={backdropStyle}
    class={STYLES.floatingButton}
    aria-expanded="false"
    aria-controls="mobile-character-menu"
    aria-label={controls.openNavigationMenu}
  >
    <span class="sr-only" data-mobile-hamburger-toggle-label>{controls.openNavigationMenu}</span>
    <span
      data-mobile-hamburger-toggle-icon="true"
      class="
        inline-flex size-5 transform items-center justify-center
        transition-transform duration-300
      "
      aria-hidden="true"
    >
      <Icon data-mobile-hamburger-icon-menu="true" name="tabler:menu-2" class="size-5" aria-hidden="true" />
      <Icon data-mobile-hamburger-icon-close="true" name="tabler:x" class="hidden size-5" aria-hidden="true" />
    </span>
  </button>

  {/* Full-screen frosted panel like apple.com's mobile menu; it sits under the toggle (z-70) so the X stays on top. */}
  <div
    id="mobile-character-menu"
    data-mobile-hamburger-panel="true"
    aria-hidden="true"
    style={`--menu-rows: ${3 + activeNavItems.length}`}
    class="
      pointer-events-none fixed inset-0 z-[65] hidden overflow-y-auto overscroll-contain
      bg-white/90 px-12 pt-16 pb-28 opacity-0 backdrop-blur-[20px] backdrop-saturate-180
      transition-opacity duration-220 ease-out
      focus:outline-hidden
      dark:bg-[rgb(29_29_31/0.8)]
    "
  >
    <ul>
      <li data-mobile-hamburger-row style={rowStyle(0)}>
        <button
          type="button"
          data-mobile-hamburger-search-action="true"
          data-link-style="true"
          class={`${utilityActionButtonClassName} appearance-none border-0 bg-transparent p-0 text-left no-underline`}
        >
          <span class={utilityActionTextClassName}>{controls.search}</span>
        </button>
      </li>

      <li data-mobile-hamburger-row style={rowStyle(1)}>
        <button
          type="button"
          data-mobile-hamburger-view-mode-toggle="true"
          data-view-mode="character"
          aria-pressed="true"
          class={`${utilityActionButtonClassName} appearance-none border-0 bg-transparent p-0 text-left text-gray-900 dark:text-white`}
        >
          <span class={utilityActionTextClassName}>{controls.byCharacter}</span>
          <Icon data-mobile-hamburger-view-mode-indicator="true" name="tabler:arrow-badge-left-filled" class="size-5 scale-100 text-gray-400 opacity-100 transition-[opacity,scale] duration-300" aria-hidden="true" />
        </button>
      </li>

      <li data-mobile-hamburger-row style={rowStyle(2)}>
        <button
          type="button"
          data-mobile-hamburger-view-mode-toggle="true"
          data-view-mode="timeline"
          aria-pressed="false"
          class={`${utilityActionButtonClassName} appearance-none border-0 bg-transparent p-0 text-left`}
        >
          <span class={utilityActionTextClassName}>{controls.byDate}</span>
          <Icon data-mobile-hamburger-view-mode-indicator="true" name="tabler:arrow-badge-left-filled" class="size-5 scale-95 text-gray-400 opacity-0 transition-[opacity,scale] duration-300" aria-hidden="true" />
        </button>
      </li>
    </ul>

    <div data-mobile-nav-root="true">
      <div class="relative" data-mobile-character-menu-list="true">
        <div data-mobile-hamburger-nav-panel="character">
          <section data-mobile-character-section="active">
            <button
              type="button"
              data-mobile-character-section-toggle="true"
              data-mobile-character-section-key="active"
              data-mobile-hamburger-row
              style={rowStyle(3)}
              aria-expanded="true"
              aria-controls="mobile-active-characters"
              class={sectionToggleClassName}
            >
              <span>{controls.activeCharacters}</span>
              <Icon data-mobile-character-section-chevron="true" name="tabler:chevron-down" class="size-4 rotate-180 transition-transform duration-200" aria-hidden="true" />
            </button>
            <div
              id="mobile-active-characters"
              data-mobile-character-section-panel="active"
            >
              <div class="min-h-0 overflow-hidden">
              {
                activeNavItems.length > 0
? (
                  <ul>
                    {activeNavItems.map((item, index) => (
                      <li class="relative" data-mobile-hamburger-row style={rowStyle(4 + index)}>
                        <a
                          href={item.sectionHash}
                          data-mobile-nav-link="true"
                          data-mobile-nav-character-status="active"
                          data-mobile-nav-section-id={item.sectionId}
                          class={STYLES.listItem}
                        >
                          {item.displayName}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
: (
                  <p class="
                    py-2 text-sm text-gray-500
                    dark:text-gray-400
                  "
                  >
                    {controls.noActiveCharacters}
                  </p>
                )
              }
              </div>
            </div>
          </section>

          <section data-mobile-character-section="archived">
            <button
              type="button"
              data-mobile-character-section-toggle="true"
              data-mobile-character-section-key="archived"
              data-mobile-hamburger-row
              style={rowStyle(archivedToggleRow)}
              aria-expanded="false"
              aria-controls="mobile-archived-characters"
              class={sectionToggleClassName}
            >
              <span>{controls.archivedCharacters}</span>
              <Icon data-mobile-character-section-chevron="true" name="tabler:chevron-down" class="size-4 transition-transform duration-200" aria-hidden="true" />
            </button>
            <div
              id="mobile-archived-characters"
              data-mobile-character-section-panel="archived"
              data-collapsed
            >
              <div class="min-h-0 overflow-hidden">
              {
                archivedNavItems.length > 0
? (
                  <ul>
                    {archivedNavItems.map(item => (
                      <li class="relative">
                        <a
                          href={item.sectionHash}
                          data-mobile-nav-link="true"
                          data-mobile-nav-character-status="archived"
                          data-mobile-nav-section-id={item.sectionId}
                          class={STYLES.listItem}
                        >
                          {item.displayName}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
: (
                  <p class="
                    py-2 text-sm text-gray-500
                    dark:text-gray-400
                  "
                  >
                    {controls.noArchivedCharacters}
                  </p>
                )
              }
              </div>
            </div>
          </section>
        </div>

        <div data-mobile-hamburger-nav-panel="timeline" class="mt-8 hidden">
          <ul>
            {
              monthNavItems.map((item, index) => (
                <li class="relative" data-mobile-hamburger-row style={rowStyle(3 + index)}>
                  <a
                    href={`/?view=timeline${item.sectionHash}`}
                    data-mobile-nav-link="true"
                    data-mobile-nav-section-id={item.sectionId}
                    class={STYLES.listItem}
                  >
                    {item.displayName}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* apple.com's menu motion: rows fade and drop in, staggered, with its cubic-bezier(0.4, 0, 0.6, 1). Closing is flat. */
  /* Rows shrink from Apple's ~52px toward 40px so the default view (three utilities plus the active characters)
     fits one screen; past that floor, or with archived or the timeline open, the panel scrolls.
     18.5rem is the panel's vertical padding plus both section labels. */
  [data-mobile-hamburger-panel] {
    --menu-row: clamp(2.5rem, (100dvh - 18.5rem) / var(--menu-rows), 3.25rem);
    --menu-font: calc(var(--menu-row) * 0.54);
    --menu-pad: calc((var(--menu-row) - var(--menu-font) * 1.15) / 2);
  }

  [data-mobile-hamburger-row] {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 240ms cubic-bezier(0.4, 0, 0.6, 1),
      transform 240ms cubic-bezier(0.4, 0, 0.6, 1);
  }

  [data-mobile-hamburger-open='true'] [data-mobile-hamburger-row] {
    opacity: 1;
    transform: none;
    transition-delay: calc(80ms + min(var(--i, 0), 12) * 25ms);
  }

  [data-mobile-hamburger-open='true'] [data-mobile-hamburger-panel] {
    transition-duration: 400ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
  }

  /* Section lists slide open and shut with the same curve: a 0fr to 1fr grid row animates their auto height in every
     engine. visibility (not hidden) keeps a collapsed list out of focus order and the accessibility tree, and it stays
     visible until the close finishes. The wrapper div clips, because padding on the list would survive a 0fr row. */
  [data-mobile-character-section-panel] {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 320ms cubic-bezier(0.4, 0, 0.6, 1),
      opacity 240ms cubic-bezier(0.4, 0, 0.6, 1),
      visibility 320ms;
  }

  [data-mobile-character-section-panel][data-collapsed] {
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mobile-hamburger-row] {
      transform: none;
    }
  }
</style>
