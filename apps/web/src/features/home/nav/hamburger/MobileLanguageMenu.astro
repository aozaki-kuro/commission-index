---
import type { HomeLocaleOption } from '@features/home/i18n/homeLocale'
import { STYLES } from '@features/home/nav/hamburger/constants'
import { Icon } from 'astro-icon/components'

interface MobileLanguageMenuProps {
  locale: string
  localeOptions: HomeLocaleOption[]
  localeSwitcherLabel: string
}

const { locale, localeOptions, localeSwitcherLabel } = Astro.props as MobileLanguageMenuProps
const backdropStyle = {
  WebkitBackdropFilter: STYLES.backdrop,
  backdropFilter: STYLES.backdrop,
}
---

<div
  data-mobile-language-menu-root="true"
  class="
    pointer-events-none fixed right-8 bottom-8 z-90 size-10 opacity-100
    transition-[opacity,translate] duration-200
    data-[floating-hidden]:translate-y-[calc(100%+2rem)] data-[floating-hidden]:opacity-0
    data-[floating-hidden]:*:pointer-events-none
    motion-reduce:data-[floating-hidden]:translate-y-0
    lg:hidden
  "
>
  <div
    data-mobile-language-menu-anchor="true"
    class="pointer-events-auto absolute right-0 bottom-[calc(100%+0.75rem)]"
  >
    <details data-mobile-language-menu="true" class="group relative">
      <summary
        style={backdropStyle}
        aria-label={localeSwitcherLabel}
        class={`
          ${STYLES.floatingButton}
          list-none
          [&::-webkit-details-marker]:hidden
        `}
      >
        <span class="sr-only">{localeSwitcherLabel}</span>
        <Icon name="tabler:language" class="size-6" aria-hidden="true" />
      </summary>

      <ul
        data-mobile-language-menu-panel="true"
        class="
          menu-glass pointer-events-none absolute right-4 bottom-full z-95 mb-3 w-48
          origin-bottom-right translate-y-1 scale-95 space-y-1 p-2 opacity-0
        "
      >
        {
          localeOptions.map((option) => {
            const isActive = option.locale === locale
            return (
              <li>
                <a
                  href={option.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`group flex w-full items-center justify-between rounded-lg px-4 py-1 text-sm no-underline transition-colors duration-150 ${
                    isActive
                      ? 'text-gray-900 dark:text-white'
                      : 'text-gray-700 hover:bg-white/70 dark:text-gray-200 dark:hover:bg-white/10'
                  }`.trim()}
                >
                  <span>{option.label}</span>
                  {isActive
? (
                    <span
                      aria-hidden="true"
                      class="
                        size-1.5 rounded-full bg-gray-500/80
                        dark:bg-gray-300/80
                      "
                    />
                  )
: null}
                </a>
              </li>
            )
          })
        }
      </ul>
    </details>
  </div>
</div>

<style>
  /* Same timing as the search popovers: a quick expo-out open and a shorter ease-in close. */
  [data-mobile-language-menu-panel] {
    transition:
      opacity 120ms ease-in,
      translate 120ms ease-in,
      scale 120ms ease-in;
  }

  [data-mobile-language-menu][open] [data-mobile-language-menu-panel] {
    transition-duration: 180ms;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Content of a closed <details> is skipped, so the panel has no style to transition from when it opens. */
  @starting-style {
    [data-mobile-language-menu][open] [data-mobile-language-menu-panel] {
      opacity: 0;
      translate: 0 0.25rem;
      scale: 0.95;
    }
  }

  /* A closed <details> hides its content at once; holding content-visibility lets the panel fade out first. */
  [data-mobile-language-menu]::details-content {
    transition: content-visibility 120ms allow-discrete;
  }
</style>
