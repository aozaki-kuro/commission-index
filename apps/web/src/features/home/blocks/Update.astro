---
import type { Props as CommissionData } from '@data/types'
import type { HomeUpdateSummary } from '@lib/home/updateSummary'
import { getHomeLocaleMessages, normalizeHomeLocale } from '@features/home/i18n/homeLocale'
import {
  buildHomeUpdateSummary,

  isMilestoneCommissionCount,
} from '@lib/home/updateSummary'

interface Props {
  locale?: string
  commissionData: CommissionData
  activeCharacters: string[]
  summary?: HomeUpdateSummary
}

const { locale, commissionData, activeCharacters, summary } = Astro.props as Props
const messages = getHomeLocaleMessages(normalizeHomeLocale(locale))
const resolvedSummary = summary ?? buildHomeUpdateSummary(commissionData, activeCharacters)
---

{
  resolvedSummary.entries.length === 0
? (
    <p class="text-sm">{messages.update.noActiveUpdatesFound}</p>
  )
: (
    <div
      data-home-update-links="true"
      class="
        mt-8 mb-6 flex flex-col text-xs
        sm:text-sm
        md:mt-10
      "
    >
      <p class="mb-2">
        {messages.update.formatTotalCommissions(resolvedSummary.totalCommissions)}
        {isMilestoneCommissionCount(resolvedSummary.totalCommissions) ? ' 🎉' : ''}
      </p>

      <div class="flex items-start">
        <p class="mr-2">{messages.update.lastUpdate}</p>
        <div class="flex flex-col space-y-2">
          {
            resolvedSummary.entries.map(entry => (
              <p class="mr-2">
                <span class="font-mono">{entry.dateLabel}</span> [ <a
                  href={entry.href}
                  data-home-update-link="true"
                  class="underline-offset-2"
                                                                   >{entry.character}</a> ]
              </p>
            ))
          }
        </div>
      </div>
    </div>
  )
}
