---
import { formatBuildLabel } from '@commission-index/domain'
import { getGeneratedFactSourceContent } from '@data/generatedFactSource'
import { getHomeLocaleMessages, normalizeHomeLocale } from '@features/home/i18n/homeLocale'

interface Props {
  locale?: string
}

const { locale } = Astro.props as Props
const messages = getHomeLocaleMessages(normalizeHomeLocale(locale))
const buildLabel = formatBuildLabel(getGeneratedFactSourceContent().meta)
const currentYear = new Date().getFullYear()
---

<div id="--------Footer--------">
  <hr class="
    my-8
    md:mt-12
  "
  />

  <div class="pb-8 text-center text-xs">
    {messages.footer.rightsLines.map(line => <p class="pt-2">{line}</p>)}
    <p class="pt-2">{messages.footer.obscuredNames}</p>
    <p class="pt-2">{messages.footer.noIndexing}</p>
  </div>

  <div class="
    pt-16 pb-10 text-gray-800
    md:pb-0
    dark:text-gray-300
  "
  >
    <div class="flex items-baseline justify-between gap-4 text-xs">
      <small class="text-xs">© <time class="tabular-nums">2022–{currentYear}</time> Crystallize</small>
      <a
        href="mailto:dmca@crystallize.cc"
        class="
          decoration-inherit decoration-dotted underline-offset-2
          dark:text-gray-300
        "
      >
        DMCA
      </a>
    </div>
    <div class="mt-1 font-mono text-[11px] text-gray-500 dark:text-gray-400" data-build-label>{buildLabel}</div>
  </div>
</div>
