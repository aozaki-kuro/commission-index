{
  "name": "@commission-index/web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "fact-source:export": "FACT_SOURCE_WRANGLER_CONFIG=../web/wrangler.jsonc pnpm -C ../admin-worker web:fact-source:export",
    "fact-source:sync-images": "FACT_SOURCE_WRANGLER_CONFIG=../web/wrangler.jsonc pnpm -C ../admin-worker web:fact-source:sync-images",
    "build:astro": "astro build",
    "check:astro": "astro check .",
    "dev": "pnpm run fact-source:sync-images && NODE_ENV=development astro dev",
    "build": "astro build",
    "check": "astro check .",
    "preview": "pnpm run fact-source:export && astro build --clean && astro preview",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm -C ../.. test",
    "test:changed": "pnpm -C ../.. test:changed",
    "test:watch": "pnpm -C ../.. test:watch",
    "test:visual": "pnpm -C ../.. test:visual",
    "test:visual:update": "pnpm -C ../.. test:visual:update"
  },
  "dependencies": {
    "@commission-index/domain": "workspace:*",
    "@iconify-json/tabler": "^1.2.40",
    "astro-icon": "^1.2.0",
    "fuse.js": "^7.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.5",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5"
  }
}
