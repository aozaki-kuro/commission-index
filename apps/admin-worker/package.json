{
  "name": "@commission-index/admin-worker",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:assets": "pnpm -C ../admin build",
    "dev": "wrangler dev --config wrangler.jsonc",
    "dev:remote": "wrangler dev --config wrangler.jsonc",
    "d1:migrate": "wrangler d1 migrations apply DB --config wrangler.jsonc --remote",
    "web:fact-source:export": "tsx ./scripts/exportWebFactSource.ts",
    "web:fact-source:sync-images": "tsx ./scripts/syncMissingSourceImages.ts",
    "r2:list-orphans": "tsx ./scripts/listR2Orphans.ts",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@commission-index/domain": "workspace:*"
  },
  "devDependencies": {}
}
