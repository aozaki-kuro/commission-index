{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",
  "dependencyDashboard": true,
  "rangeStrategy": "replace",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "description": "Astro core stack",
      "matchPackageNames": ["astro", "@astrojs/react", "@astrojs/check"],
      "groupName": "astro stack"
    },
    {
      "description": "Vite build toolchain",
      "matchPackageNames": ["vite", "@tailwindcss/vite"],
      "groupName": "vite toolchain"
    },
    {
      "description": "React runtime packages",
      "matchPackageNames": ["react", "react-dom", "cmdk"],
      "groupName": "react runtime"
    },
    {
      "description": "Type declarations",
      "matchPackageNames": ["@types/react", "@types/react-dom", "@types/node"],
      "groupName": "types"
    },
    {
      "description": "Tailwind and styling ecosystem",
      "matchPackageNames": [
        "tailwindcss",
        "tailwind-merge",
        "class-variance-authority",
        "clsx",
        "eslint-plugin-better-tailwindcss"
      ],
      "groupName": "tailwind and styling"
    },
    {
      "description": "Lint and hooks tooling",
      "matchPackageNames": [
        "eslint",
        "@antfu/eslint-config",
        "@eslint-react/eslint-plugin",
        "eslint-plugin-astro",
        "eslint-plugin-format",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "lint-staged",
        "@j178/prek"
      ],
      "groupName": "lint and hooks"
    },
    {
      "description": "Testing stack",
      "matchPackageNames": [
        "vitest",
        "jsdom",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@playwright/test"
      ],
      "groupName": "test stack"
    },
    {
      "description": "TypeScript toolchain",
      "matchPackageNames": ["typescript"],
      "groupName": "typescript toolchain"
    },
    {
      "description": "Radix UI components",
      "matchPackagePrefixes": ["@radix-ui/"],
      "groupName": "radix ui"
    },
    {
      "description": "DnD kit",
      "matchPackageNames": ["@dnd-kit/core", "@dnd-kit/sortable", "@dnd-kit/utilities"],
      "groupName": "dnd-kit"
    },
    {
      "description": "Infra and deploy tooling",
      "matchPackageNames": ["wrangler", "sharp", "turbo"],
      "groupName": "infra and deploy"
    },
    {
      "description": "Runtime utilities",
      "matchPackageNames": [
        "fuse.js",
        "@tabler/icons-react",
        "@fontsource/ibm-plex-sans"
      ],
      "groupName": "runtime utilities"
    },
    {
      "description": "Formatting",
      "matchPackageNames": ["prettier"],
      "groupName": "formatting"
    },
    {
      "description": "Automerge stable minor and patch updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Never automerge high-risk or native/runtime-critical dependencies",
      "matchPackageNames": [
        "astro",
        "@astrojs/react",
        "@astrojs/check",
        "react",
        "react-dom",
        "cmdk",
        "vite",
        "wrangler",
        "sharp"
      ],
      "automerge": false
    }
  ]
}
