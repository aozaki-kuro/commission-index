{
  "name": "nsfw-commission-neo",
  "type": "module",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "author": "Crystallize",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:fact-source:export": "pnpm -C apps/admin-worker web:fact-source:export",
    "web:fact-source:sync-images": "pnpm -C apps/web fact-source:sync-images",
    "build": "pnpm run build:web",
    "build:all": "pnpm run build:web && pnpm run build:admin",
    "build:admin": "pnpm -C apps/admin build",
    "build:web": "pnpm -C apps/web run fact-source:export && pnpm -C apps/web build",
    "check": "pnpm -C apps/web run fact-source:export && pnpm -C apps/web run check:astro",
    "clean": "rm -rf node_modules .wrangler apps/web/.astro apps/web/dist coverage playwright-report test-results && pnpm i",
    "deploy": "pnpm run deploy:web",
    "deploy:admin": "pnpm -C apps/admin-worker deploy",
    "deploy:web": "pnpm -C apps/web deploy",
    "dev": "pnpm -C apps/web dev",
    "dev:admin": "tsx scripts/devAdminRemote.ts",
    "dev:admin:remote": "tsx scripts/devAdminRemote.ts",
    "dev:web": "pnpm -C apps/web dev",
    "dev:worker": "pnpm -C apps/admin-worker dev",
    "lint": "eslint . --config config/eslint.config.ts --max-warnings=0",
    "lint:fix": "eslint . --config config/eslint.config.ts --fix",
    "prepare": "prek install",
    "preview": "pnpm -C apps/web preview",
    "test": "vitest run -c config/vitest.config.ts",
    "test:admin-ui": "playwright test -c apps/admin/playwright.ui.config.ts",
    "test:changed": "vitest run -c config/vitest.config.ts --changed",
    "test:visual": "playwright test -c config/playwright.config.ts",
    "test:visual:update": "playwright test -c config/playwright.config.ts --update-snapshots",
    "test:watch": "vitest -c config/vitest.config.ts",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@j178/prek": "^0.5.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "lint-staged": {
    "*": [
      "eslint --config config/eslint.config.ts --fix"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  }
}
